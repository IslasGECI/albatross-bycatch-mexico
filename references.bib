@article{afan2018adaptive,
  author = {Af{\'a}n, Isabel and Gim{\'e}nez, Joan and Forero, Manuela G and Ram{\'i}rez, Francisco},
  journal = {Conservation Biology},
  number = {6},
  pages = {1436--1447},
  publisher = {Wiley Online Library},
  title = {An adaptive method for identifying marine areas of high conservation priority},
  volume = {32},
  year = {2018},
  abstract = {We used the Patagonian seabird breeding community as a case study to propose an integrated and adaptive method for delimiting key marine areas for conservation. Priority areas were defined through a free decision-support tool (Marxan) that included projected at-sea distributions of seabirds (approximately 2,225,000 individuals of 14 species); BirdLife Important Bird and Biodiversity Areas (IBAs) for pelagic bird species; and the economic costs of potential regulations in fishing practices.},
  analytical_methods = {Hanski's (1998) isolation function to project at-sea distributions; Marxan systematic conservation planning with 500 runs; BirdLife marine IBA inclusion in two scenarios; Circuit theory connectivity modelling in Circuitscape; Chlorophyll-a time-series analysis from SeaWiFS and MODIS sensors},
  category = {Methods},
  equations = {Isolation function for projecting at-sea distribution from colony size and foraging range; Marxan cost and benefit functions; Circuit theory effective resistance between nodes},
  island = {Patagonian coast, Argentina},
  keywords = {Marine protected areas; Marxan; Ocean currents; Remote sensing; Reserve design; Seabird at-sea distribution},
  limitations = {Lack of species and colony-specific foraging distribution data; Foraging distances not modelled as varying with colony size or sea area; Individuals breeding outside the study area excluded from at-sea projections but included in reserve design via IBAs; Fishing effort used as a proxy for both economic cost and bycatch impact; No guidelines exist for using pelagic IBAs in marine protected area delimitation; Network could be meaningless outside the breeding season},
  objectives = {To project the at-sea distribution of the Patagonian seabird breeding community from colony censuses and known foraging ranges; To delimit priority areas fulfilling species-specific conservation targets while minimizing the economic costs of potential fishing regulations; To identify the water masses that may influence those priority areas through marine current inflow},
  research_question = {How can key marine areas for seabird conservation be delimited in a large, remote and continuous system where tracking data are scarce and the conservation effort must compete with fisheries?},
  results = {The IBAs scenario covered 280,000 km2 (4495 planning units) across up to 20 priority areas, exceeding the 20% protection target for species of least concern (41.1-87.3%) and 30% for near-threatened species (30-66.6%); Adding IBAs to the reference solution reached 330,000 km2 (6281 planning units) in 23 areas, with targets met for all species (46.5-89.6% least concern, 44.2-73.5% near-threatened); Three primary water masses were identified as potentially influencing the priority areas through water inflow},
  software = {Marxan version 1.8.10; Zonae Cogito; Circuitscape},
  species = {Penguins; Albatrosses; Petrels; Shearwaters; Cormorants; Gulls; Terns; Skuas},
  time_period = {1993-2017},
  variables = {Projected at-sea distribution of 14 breeding species; Species conservation targets; Important Bird and Biodiversity Areas; Fishing effort; Marine currents; Resistance layers; Chlorophyll-a concentration; Point-source pollution},
}

@article{anderson2011global,
  author = {Anderson, Orea RJ and Small, Cleo J and Croxall, John P and Dunn, Euan K and Sullivan, Benedict J and Yates, Oliver and Black, Andrew},
  journal = {Endangered Species Research},
  pages = {91--106},
  title = {Global seabird bycatch in longline fisheries},
  volume = {14},
  year = {2011},
  abstract = {Bycatch in longline fisheries is believed to govern the adverse conservation status of many seabird species, but no comprehensive global assessment has been undertaken. We reviewed the extent of seabird bycatch in all longline fisheries for which data are available. Despite the many inadequacies and assumptions contained therein, we estimated that at least 160 000 (and potentially in excess of 320 000) seabirds are killed annually. Most frequently caught are albatrosses, petrels and shearwaters, with current levels of mortality liable to be unsustainable for some species and populations.},
  analytical_methods = {Review of published and unpublished literature; Scaling of bycatch per unit effort to whole-fleet effort; Extrapolation from analogous fisheries; Calculation of ranges from lowest and highest bycatch per unit effort and effort; Reliability scoring for age, source and accuracy; Comparison with Nel and Taylor 2003; Expert review by country and region},
  category = {State of the art},
  equations = {not_applicable},
  island = {Global},
  keywords = {Bycatch; Seabirds; Albatrosses; Global; Threats; Marine conservation},
  limitations = {Many inadequacies and assumptions in the estimates; Reliability was Poor for nine of the top 10 fleets; Estimates are likely conservative because observed rates underestimate total bycatch; Data gaps remain for artisanal and industrial fleets; Absolute levels may be up to 50 percent higher due to unobserved or under-reported birds},
  objectives = {Review published and unpublished seabird bycatch data for longline fisheries worldwide and provide a comprehensive annotated archive; Generate new estimates of seabird bycatch, including at a global scale, and compare them with previous reviews; Identify reasons for changes and emerging bycatch problems; Highlight continuing data gaps; Indicate future challenges and provide recommendations for priority actions},
  research_question = {Bycatch in longline fisheries is believed to govern the adverse conservation status of many seabird species, but no comprehensive global assessment has been undertaken.},
  results = {Data from 68 longline fisheries; About 160 000 seabirds killed globally each year, with an upper range of about 320 000; Reliability was Good for 15 estimates, Medium for 23 and Poor for 30; Nine of the top 10 fleets scored Poor; Highest bycatch in the Spanish Gran Sol hake, Japanese North Pacific tuna, Namibian hake and Nordic demersal fleets; Substantially reduced bycatch in some key fisheries since the 1990s},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {1986-2009},
  variables = {Bycatch per unit effort; Fishing effort; Average number of seabirds killed per year; Upper and lower bycatch ranges; Data reliability score; Observer coverage},
}

@article{baker2007global,
  author = {Baker, G Barry and Double, Michael C and Gales, Rosemary and Tuck, Geoffrey N and Abbott, Cathryn L and Ryan, Peter G and Petersen, Samantha L and Robertson, Christopher JR and Alderman, Rachael},
  journal = {Biological Conservation},
  number = {3},
  pages = {319--333},
  publisher = {Elsevier},
  title = {A global assessment of the impact of fisheries-related mortality on shy and white-capped albatrosses: conservation implications},
  volume = {137},
  year = {2007},
  abstract = {Hundreds of thousands of seabirds are killed each year as a result of interacting with longline and trawl fishing operations, and the severity of the impact varies regionally. Shy and white-capped albatrosses, Thalassarche cauta and Thalassarche steadi respectively, are phenotypically similar species known to be incidentally killed by fishing operations. The magnitude of this mortality has not previously been assessed across their range. Here we examine recent effort and bycatch rates in fisheries known to incidentally kill these species and qualitatively evaluate the level of impact of each fishery.},
  analytical_methods = {Compilation of at least five years of effort and bycatch data per fishery after 1995; Effort mapped on a 5 by 5 degree grid; Annual and quarterly seasonal analysis; Division of the area into five zones; Estimation of total annual mortality and the shy-type component; Qualitative impact categories by deaths; Reliability indicator from observer coverage; Inference from distribution where observer data were absent},
  category = {State of the art},
  equations = {not_applicable},
  island = {Global},
  keywords = {Trawl and longline fisheries; Seabird bycatch; Bycatch mitigation; Thalassarche; Albatross},
  limitations = {Reliability of the estimate is low due to the paucity of comprehensive observer data in most fisheries; Low or unrepresentative observer coverage makes extrapolations potentially inaccurate and misleading; Confidence is low where observer data are virtually absent; Only four of 13 fisheries had high reliability; Estimates could significantly under- or over-estimate the true number of shy-type albatrosses killed},
  objectives = {Assess the likely impact of bycatch mortality on shy and white-capped albatrosses throughout the Southern Oceans on a fishery-by-fishery basis; Examine current levels of effort in fisheries known to incidentally kill shy-type albatrosses; Evaluate the degree to which they overlap with each of the two species; Estimate the impact of fisheries bycatch mortality for each species separately},
  research_question = {Previously, it has not been possible to assess the extent or scale of impact of bycatch mortality on shy and white-capped albatrosses, in part due to an inability to identify bycatch shy-type albatross carcasses to species level.},
  results = {Over 8500 shy-type albatrosses may be killed annually; Trawl and longline fisheries killed seabirds in similar proportions (45 and 55 percent), but trawl fisheries caused 75 percent of shy-type deaths; Six of 13 fisheries were very high impact for seabirds and two killed more than 10 000 birds each year; The five high or very high impact fisheries for shy-type albatrosses were led by the South African demersal trawl fishery (60 percent); Only four of 13 fisheries had high reliability},
  software = {not_applicable},
  species = {Shy albatross; White-capped albatross},
  time_period = {1995-2005},
  variables = {Fishing effort; Bycatch rates; Estimated annual seabird mortality; Shy-type albatross mortality; Observer coverage; Species distribution; Overlap between effort and distribution; Impact category; Reliability indicator},
}

@article{beal2021track2kba,
  author = {Beal, Martin and Oppel, Steffen and Handley, Jonathan and Pearmain, Elizabeth J and Morera-Pujol, Virginia and Carneiro, Ana PB and Davies, Tammy E and Phillips, Richard A and Taylor, Philip R and Miller, Mark GR and others},
  journal = {Methods in Ecology and Evolution},
  number = {12},
  pages = {2372--2378},
  publisher = {Wiley Online Library},
  title = {track2KBA: An R package for identifying important sites for biodiversity from tracking data},
  volume = {12},
  year = {2021},
  abstract = {We introduce the R package 'track2KBA', a tool to identify important sites at the population level using tracking data from individual animals based on three key steps: (a) identifying individual core areas, (b) assessing population-level representativeness of the sample and (c) quantifying spatial overlap among individuals and scaling up to the population. We describe package functionality and exemplify its application using tracking data from three taxa in contrasting environments: a seal, a marine turtle and a migratory land bird.},
  analytical_methods = {Kernel density estimation of the utilization distribution via estSpaceUse; Iterative subsampling and pooled functions via repAssess to estimate representativeness and the asymptote; Population scaling and site delineation via findSite using a threshold proportion of individuals; Illustrative applications to three tracking datasets},
  category = {Methods},
  equations = {Kernel density estimation of the utilization distribution; Representativeness estimated as the proportion of out-of-sample locations within a subsample-derived utilization distribution; Population scaling from the estimated proportion of individuals predictably using each grid cell},
  island = {not_applicable},
  keywords = {Animal movement; Biologging; Important Bird and Biodiversity Areas; Key biodiversity areas; Protected areas; Site-based conservation; Utilization distribution},
  limitations = {Kernel bandwidth h must be chosen by the user and affects the spatial estimate; The grid resolution and probability quantile both require user selection, and 50% is a standard rather than fixed choice; Requires the size of the source population to be known or estimated for population scaling},
  objectives = {To introduce an R package that identifies individual core areas, assesses population-level representativeness of the tracking sample, and quantifies spatial overlap among individuals scaled to the population; To exemplify the package on tracking data from three taxa in contrasting environments; To show how the output supports site delineation under the Key Biodiversity Area Standard},
  research_question = {How can tracking data from individual animals be turned into sites of ecological relevance that can be assessed against systematic criteria such as the Key Biodiversity Area Standard?},
  results = {The package provides four functions and nine accessory functions covering the workflow from splitting tracks into events to delineating and plotting sites; The worked Antarctic fur seal example estimated 96% representativeness for 117 tracked individuals and delineated areas used by at least 10% of the local population; The workflow produces output that can be assessed against the Key Biodiversity Area Standard for conservation planning at global and regional levels},
  software = {track2KBA},
  species = {Antarctic fur seals; Green sea turtles; White storks},
  time_period = {not_applicable},
  variables = {Individual core areas; Sample representativeness; Spatial overlap among individuals; Source population size; Smoothing parameter h; Probability quantile of the utilization distribution; Grid resolution for KDE; Grid cells used by a threshold proportion of the population},
}

@article{belda2001seabird,
  author = {Belda, Eduardo J and Sanchez, A},
  journal = {Biological Conservation},
  number = {3},
  pages = {357--363},
  publisher = {Elsevier},
  title = {Seabird mortality on longline fisheries in the western Mediterranean: factors affecting bycatch and proposed mitigating measures},
  volume = {98},
  year = {2001},
  abstract = {Seabird mortality on longlines in the Western Mediterranean around Columbretes Islands (Spain) was studied by observers in 1998–1999, and ringing recoveries obtained from 1992 to 1998. Average numbers varied between 0.16 and 0.69 birds/1000 hooks set, and incidental mortality affected seven different seabird species. Bycatch occurred mainly around sunrise and from mid afternoon until dusk. This was related to seabird abundance but not with fishing effort (number of hooks set). About 656–2829 birds were estimated to be killed annually, of which 66% were Cory's shearwaters (Calonectris diomedea). In this species mortality was mainly among adult birds and affected reproductive success.},
  analytical_methods = {Observers on eight longline vessels during 129 setting and hauling operations in 1998 and 1999; Counts of attending seabirds every 10 minutes; Recording of hooks, birds, species and setting times; Expected captures per period weighted by hooks; Log-likelihood ratio test; Ringing recoveries from 1992 to 1998},
  category = {Justification},
  equations = {Expected number of birds caught per period; Log-likelihood ratio test},
  island = {Columbretes Islands, Spain},
  keywords = {Longline fishing; Bycatch; Shearwater; Mediterranean; Conservation},
  limitations = {Bycatch figures are minimum estimates because distant birds went unrecorded and some may have been lost before hauling; Age was underestimated for birds ringed as adults; Balearic shearwaters were absent from the area during the study; No evidence was found for effects of vessel speed, hook size or bait size},
  objectives = {Evaluate the rate of seabird bycatch by longline vessels in the Western Mediterranean around the Columbretes Islands; Discover which species are affected and for which longlines may pose a higher risk; Study factors that influence seabird mortality rate; Propose mitigating measures to reduce seabird mortality in the study area},
  research_question = {There is no quantitative information either on the magnitude of seabird mortality on longlines or which species may be threatened by longlining.},
  results = {Bycatch rates were 0.69 and 0.25 birds per 1000 hooks in 1998 for bottom and pelagic longlines, and 0.16 in 1999; Differences between methods and years were significant (G1 = 4.57 and 19.3); Seven species were caught, mainly Cory's shearwater, yellow-legged gull, Audouin's gull and gannet; Swallowing hooks (50 percent) and wing hooking (41 percent) dominated; Bycatch peaked around sunrise and from mid afternoon until dusk; About 656 to 2829 birds were killed annually, of which 66 percent were Cory's shearwaters; Setting at night or from one hour after sunrise until mid afternoon may reduce bycatch},
  software = {not_applicable},
  species = {Cory's shearwater; Yellow-legged gull; Audouin's gull; Balearic shearwater; Gannet; Common tern; Great skua},
  time_period = {1992-1999},
  variables = {Bycatch rate; Number of hooks set; Fishing effort; Seabird abundance; Time of setting; Breeding stage; Species; Age; Moonlight; Reproductive success},
}

@techreport{birdlife2010marine,
  address = {Cambridge, UK},
  author = {{BirdLife International}},
  institution = {BirdLife International},
  note = {Version 1.2: February 2011},
  title = {Marine Important Bird Areas toolkit: standardised techniques for identifying priority sites for the conservation of seabirds at sea},
  year = {2010},
  abstract = {The Important Bird Area (IBA) Programme of BirdLife International has been used to identify priority sites for conservation for over 30 years. Until recently the programme has focused primarily on terrestrial and freshwater environments, but in the last decade there has been an expansion of the work within the BirdLife Partnership to identify IBAs in the marine environment. Extending the IBA programme to the oceans, while a logical and significant development, has posed both conceptual and practical challenges.},
  analytical_methods = {Identify priority species for marine IBA analysis; Gather seabird distribution and environmental data; Create GIS layers by species; Determine primary and supplementary layers; Identify candidate sites; Apply IBA criteria and thresholds; Delimit boundaries and merge overlapping sites; Produce site descriptions and propose IBAs in the World Bird Database; Review by BirdLife Secretariat},
  category = {Methods},
  equations = {IBA A4 threshold of one percent of a population; Thresholds of 20 000 waterbirds and 10 000 pairs of seabirds},
  island = {Global},
  keywords = {not_applicable},
  limitations = {Large areas of the marine environment remain unsurveyed for seabirds, particularly beyond national jurisdiction; Surveyed areas often lack temporal data to assess regular use; The eight-step protocol is an ideal scenario that data availability may not allow; The document is a working document to be updated},
  objectives = {Create a toolkit for identifying and delimiting marine IBAs in a consistent and comparable manner; Recommend rules that maintain a global standard; Provide examples of marine IBA work; Review analysis techniques and data sources; Serve as a resource for choosing appropriate data sources and methodologies},
  research_question = {Their habits at-sea are often poorly understood and the areas most important for their survival have rarely been defined in any systematic way.},
  results = {not_applicable},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {Regular use; Foraging range; At-sea survey data; Habitat suitability; GIS layers; Site boundaries; IBA thresholds},
}

@article{birdlife2018phoebastria,
  author = {BirdLife International},
  doi = {10.2305/IUCN.UK.2018-2.RLTS.T22698365A132643073.en},
  journal = {The IUCN Red List of Threatened Species 2018},
  number = {e.T22698365A132643073},
  publisher = {International Union for Conservation of Nature and Natural Resources},
  title = {Phoebastria immutabilis. The IUCN Red List of Threatened Species 2018: e.T22698365A132643073},
  year = {2018},
  abstract = {This species has rebounded from declines in the late 1990s and early 2000s, perhaps because apparent changes in the breeding populations reflected large scale environmental conditions that affected the number of birds that returned to the colonies to nest rather than actual declines in the population. Given the difficulty of predicting long-term trends for such a long-lived species, and the number of documented threats and the uncertainty over their future effects, the species is precautionarily projected to undergo a moderately rapid population decline over three generations (84 years).},
  analytical_methods = {IUCN Red List Categories and Criteria version 3.1, criterion A4bd; Projection of population decline over three generations (84 years); Compilation of published and unpublished records on distribution, demography, threats and conservation actions},
  category = {Background},
  equations = {Red List criterion A4 thresholds for population reduction over a generation length; Three-generation projection for a long-lived species},
  island = {North Pacific},
  keywords = {not_applicable},
  limitations = {Long-term trends are difficult to predict for a long-lived species; Apparent changes in breeding populations may reflect environmental conditions affecting return to colonies rather than actual population change; Bycatch rates in Japanese and Taiwanese pelagic longline fisheries remain largely unknown; Breeding populations were extirpated from Wake and Johnston atolls and Minami Torishima, so data from some sites are absent},
  objectives = {To assess the extinction risk of Phoebastria immutabilis against the IUCN Red List criteria; To project the population trend over three generations; To summarise documented threats and conservation actions for the species},
  research_question = {not_applicable},
  results = {Assessed as Near Threatened; Population estimated at more than 800,000 breeding pairs, equivalent to about 1,600,000 mature individuals; Midway Atoll, Laysan Island and French Frigate Shoals support 90% of the global breeding population; A 32% decline was recorded during 1992-2002 in the Northwestern Hawaiian Islands but the overall trend for 1992-2005 is stable; A precautionary decline of 20-29% over 1992-2078 is estimated; The Mexican population is about 400 pairs at four sites, less than 0.1% of the global population},
  software = {not_applicable},
  species = {Laysan Albatross},
  time_period = {1980-2018},
  variables = {Breeding population size; Population trend; Number of breeding sites; Threats; Conservation actions; Red List category},
}

@article{brito2011captura,
  author = {Brito Chavarr\'ia, Mariela},
  title = {Captura incidental de aves marinas por la pesquer\'ia artesanal de la costa occidental de Baja California, M\'exico},
  year = {2011},
  abstract = {This study evaluated the mortality of seabirds due to interactions with artisanal fisheries off the west coast of Baja California, Mexico, through 100 semi-structured interviews at 13 fishing camps in 2010. Bycatch mortality was estimated at 621 birds over the year, with cormorants (Phalacrocorax spp.) comprising the largest proportion. Maximum mortality occurred in summer and autumn, which were significantly different from winter and spring. Fishing nets and lobster traps were the principal gears interacting with seabirds, and no mortality was recorded for pelagic longlines, fish traps or crab traps.},
  analytical_methods = {Semi-structured interviews at 13 fishing camps (100 interviews total) in 2010; Two-way ANOVA to test differences in mortality between seasons and zones; Estimation of annual bycatch mortality based on interview data; Identification of gear types involved},
  category = {Justification},
  equations = {Catch per unit effort estimates derived from interview responses; Statistical comparison by season and zone via two-way ANOVA},
  island = {West coast, Baja California, Mexico},
  keywords = {Incidental catch; Seabirds; Artisanal fisheries; Mexico},
  limitations = {The information is based on interviews rather than direct observer data; Only one count was performed for cormorant numbers and not all known breeding colonies were surveyed; Population estimates for the affected cormorant species are limited and data from 2005 to the present are scarce; The study relied on fishers' recall to estimate annual bycatch numbers},
  objectives = {To describe the artisanal fisheries of the region; To identify whether there was a relationship between fishing gear type and the seabird species caught; To identify which season had the highest seabird mortality from fishing operations; To determine geographic zones where interaction between seabirds and fisheries occurs},
  research_question = {What is the bycatch mortality of seabirds due to interactions with artisanal fisheries along the west coast of Baja California, Mexico?},
  results = {Estimated bycatch mortality of 621 seabirds over 2010; Cormorants (Phalacrocorax spp.) were the most frequent bycaught birds; Mortality was highest in summer and autumn and significantly different from winter and spring; Fishing nets and lobster traps were the main gears interacting with seabirds; No mortality recorded for pelagic longlines, fish traps or crab traps; The study provides the first evaluation of seabird mortality attributed to artisanal fisheries in Mexico},
  software = {not_applicable},
  species = {Cormorants; shearwaters},
  time_period = {2010},
  variables = {Seabird bycatch mortality; Fishing gear type; Season; Geographic zone; Catch per unit effort related to interactions},
}

@article{brothers1999incidental,
  author = {Brothers, Nigel P. and Cooper, John and L{\o}kkeborg, Svein},
  journal = {FAO Fisheries Circular},
  pages = {1--100},
  publisher = {Food and Agriculture Organization of the United Nations},
  title = {The incidental catch of seabirds by longline fisheries: worldwide review and technical guidelines for mitigation},
  volume = {937},
  year = {1999},
  abstract = {Certain longline fisheries result in large numbers of seabirds being hooked on setting lines. Species of seabirds most commonly taken are the albatrosses and large petrels of the family Procellariidae. A comprehensive number of mitigation measures for reducing the incidental catch of seabirds in longline fisheries has been developed during the past 5-10 years.},
  analytical_methods = {Worldwide review of published and grey literature and fishery statistics; Compilation of three background papers into one document; Description of gear configuration and mitigation measures; Compilation of estimated annual bycatch data from monitored fisheries},
  category = {Classic},
  equations = {not_applicable},
  island = {Global},
  keywords = {Longline fisheries; Seabird bycatch; Mitigation measures; Procellariidae; National Plans of Action},
  limitations = {Data on incidental catch are lacking for a number of longline fisheries including the Pacific coast of South America, the Mediterranean Sea and tropical waters of all oceans; Some mitigation measures exist only as concepts requiring investigation and development; Unpublished and grey literature contributed to the review},
  objectives = {To describe longline fishing methods, gear configuration and operation; To review the bycatch of seabirds in specific longline fisheries worldwide; To review longline seabird bycatch mitigation measures and their effect on other marine species},
  research_question = {How can the incidental catch of seabirds in longline fisheries be reduced worldwide through technical mitigation measures?},
  results = {Identifies the major problem fisheries as demersal fisheries of the Northeast Pacific, North Atlantic, Southern Ocean and the Atlantic coast of South America, and tuna pelagic fisheries of cool temperate seas in the North Pacific and Southern Ocean; Albatrosses and large petrels of the family Procellariidae are the seabirds most commonly taken; A comprehensive set of mitigation measures has been developed over the past 5-10 years and, with widespread use, a significant reduction in incidental catch is achievable at minimal cost},
  software = {not_applicable},
  species = {Albatrosses; Petrels},
  time_period = {not_applicable},
  variables = {Longline fishing effort; Seabird bycatch rates; Hooking rate; Gear configuration; Mitigation measure types; Vessel fishers},
}

@article{bugoni2008seabird,
  author = {Bugoni, Leandro and Mancini, Patricia L and Monteiro, Danielle S and Nascimento, Loretha and Neves, Tatiana S},
  journal = {Endangered Species Research},
  pages = {137--147},
  title = {Seabird bycatch in the Brazilian pelagic longline fishery and a review of capture rates in the southwestern Atlantic Ocean},
  volume = {5},
  year = {2008},
  abstract = {We present information on bycatch rates of seabirds in the Brazilian domestic pelagic longline fishery from 2001 to 2007, and review bycatch rates reported for the demersal and pelagic longline fisheries in the southwestern Atlantic Ocean. Overall seabird capture rate for the Brazilian pelagic longline fleet during 63 cruises (656 sets and 788 446 hooks) was 0.229 birds per 1000 hooks, varying from 0 to 0.542 according to season.},
  analytical_methods = {Observers on 63 pelagic longline cruises from 2001 to 2007; Five seabird counts before dusk at 15 minute intervals; Standardisation of effort as hooks and capture rate as birds per 1000 hooks; ICCAT fleet data for 2000 to 2006; Review of capture rates; General linear model of log transformed hooks and capture rates; Minitab v. 15},
  category = {Justification},
  equations = {General linear model of capture rate against number of hooks},
  island = {Brazilian Exclusive Economic Zone},
  keywords = {Albatrosses; Petrels; Longline; Incidental capture; Review; Brazil; Fisheries},
  limitations = {Censuses were not carried out at all settings; Only the domestic fleet carried observers, and the leased fleet was described from ICCAT data; The review was not exhaustive; Studies with small or no captures are less likely to be published; Seabird captures are stochastic},
  objectives = {Present capture rates for the Brazilian pelagic longline fishery from 2001 to 2007 and seabird abundance before setting; Describe the dynamics and magnitude of fishing effort of the domestic and leased fleets and their overlap with seabird distribution; Test whether capture rates based on limited sampling are overestimated; Provide a critical review of capture rates reported in the southwestern Atlantic Ocean},
  research_question = {not_applicable},
  results = {Overall capture rate of 0.229 birds per 1000 hooks, ranging from 0 to 0.542 by season; Capture rates were higher from June to November; Black-browed albatross made up 55 percent of captures; Previous southwestern Atlantic rates ranged from 0 to 5.03 birds per 1000 hooks; Logbooks and interviews underestimated rates while small samples overestimated them; Negative relationships between hooks and capture rates (F = 10.08 and 14.56) explained 45.2 and 53.0 percent of the variation},
  software = {Minitab v. 15},
  species = {Albatrosses; Petrels},
  time_period = {2001-2007},
  variables = {Capture rate; Number of hooks; Seabird abundance; Season; Species; Fishing effort; Fleet},
}

@article{burger2008perspectives,
  author = {Burger, Alan E and Shaffer, Scott A},
  journal = {The Auk},
  number = {2},
  pages = {253--264},
  publisher = {Oxford University Press},
  title = {Perspectives in ornithology application of tracking and data-logging technology in research and conservation of seabirds},
  volume = {125},
  year = {2008},
  abstract = {Seabirds are the most conspicuous and mobile of all pelagic marine organisms. Because most species breed colonially, researchers can study statistically large samples with relative ease. These attributes have long made seabirds valuable for interpreting conditions in the surrounding oceans. Until recently, such studies were usually based on data obtained at breeding colonies or from vessels, but in the past two decades, advances in electronic technology have greatly changed the way we study seabirds, providing unprecedented insights into their locomotion, physiology, foraging behavior, migration, demographics, and exposure to anthropogenic risks at sea.},
  analytical_methods = {Review of tracking and data-logging technologies; Comparison of satellite telemetry, geolocators, GPS loggers and depth recorders; Description of Lagrangian approaches; Examples from tracking studies},
  category = {Methods},
  equations = {not_applicable},
  island = {Global},
  keywords = {not_applicable},
  limitations = {VHF telemetry has limited location precision and range, typically 15 to 20 km; Geolocators give coarse locations with a mean error of 185 to 200 km; Devices can have negative effects on birds; The authors urge controlled studies of device effects},
  objectives = {Highlight new techniques and data; Discuss current and future applications; Illustrate the roles seabirds might play in monitoring the planet; Discuss the application of new technology in the conservation and management of seabirds; Focus on Lagrangian approaches},
  research_question = {not_applicable},
  results = {Satellite transmitters provide up to 20 locations per day with accuracy of 1 to 3 km; Geolocators give one or two locations per day with a mean error of 185 to 200 km; GPS loggers record locations every second within meters; Satellite units weigh as little as 9 grams and geolocators as little as 1.5 grams},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {Location; Depth; Acceleration; Body temperature; Heart rate; Flight speed; Foraging behavior; Migration},
}

@article{castillo2026breeding,
  author = {Castillo-Guerrero, Jos{\'e} Alfredo and Casta{\~n}eda-Castellanos, Sandy Azucena and Portillo-Zavala, Daniel Arturo and Hern{\'a}ndez-V{\'a}zquez, Salvador and Fern{\'a}ndez, Guillermo},
  journal = {Ecology and Evolution},
  number = {10},
  pages = {e74346},
  publisher = {Wiley Online Library},
  title = {Breeding on a Tropical Island Proves More Difficult Than Expected: The Ongoing Breeding Failure of Laysan Albatross on Clarion Island},
  volume = {16},
  year = {2026},
  abstract = {We assessed the breeding performance of Laysan Albatrosses on Clarion Island (2016–2023) in relation to foraging ecology and local predation. We monitored breeding success through periodic nest checks and quantified predation rates through focal observations. We tracked foraging trips using GPS devices and analyzed blood samples for stable isotopes (δ15N, δ13C). Over the study period, the colony experienced complete breeding failure. Our results suggest that two factors likely contributed to this outcome: (1) foraging limitations and (2) high predation rates.},
  analytical_methods = {Annual island-wide nest searches and twice-daily nest checks; Camera traps and direct observations of breeding failure; Focal observations at 9 nests to measure attack rate; GPS tracking with GT-120 loggers; Blood sampling for δ13C and δ15N; Chi-squared test of failure causes between years; Generalized linear mixed models with lmer() and glmer() from lme4 for attack rate; Foraging trip identification with tripSplit() from track2KBA; Expectation–maximization binary clustering for behavioral states; Kernel densities for core areas; Firth penalized logistic regression with logistf and AICc model comparison},
  category = {Background},
  equations = {Chi-squared test of independence; Generalized linear mixed model; Expectation–maximization binary clustering; Kernel density estimate; Firth penalized logistic regression; Akaike Information Criterion corrected for small sample size},
  island = {Clarion Island, Revillagigedo Archipelago, Mexico},
  keywords = {Breeding success; Foraging ecology; Nest predation; Phoebastria immutabilis; Population dynamics},
  limitations = {Specific prey could not be identified from stable isotope signatures alone; The chemical cues attracting whip snakes to nests remain unknown; The mechanisms behind the breeding range expansion remain speculative; The hatching analysis rested on 12 breeding attempts, and conventional logistic models gave unstable estimates and separation},
  objectives = {Assess the breeding success of Laysan albatrosses on Clarion Island; Describe their foraging ecology; Assess the vulnerability of eggs and hatchlings to predation},
  research_question = {Which factors limit the breeding success and colony growth of the small Laysan albatross colony on Clarion Island?},
  results = {No breeding success from 2016 to 2023, with zero fledglings per nest; Failure causes were parental abandonment followed by raven consumption (44–66%), whip snake predation (26–41%), ants (0–7%) and probable starvation (3–7%); Nine nests received 190 snake attacks, averaging 9.8 attacks per day on the first day (2–18), higher on sunny days; We collected 29 complete trips, with incubation trips averaging 3630 km maximum distance, 9925 km total and 14.5 days; Brooding trips averaged 291 km, 862 km and 47 h; Hatching success fell with δ13C (β = −2.46, odds ratio 0.09, p = 0.010)},
  software = {R v. 4.4.2; RStudio v. 2026.04.0+526; lme4; track2KBA; logistf},
  species = {Laysan albatross},
  time_period = {2016–2023},
  variables = {Hatching success; Fledging success; Causes of breeding failure; Attack rate; Weather conditions; Chick age; Maximum distance from the colony; Total trip distance; Trip duration; δ13C; δ15N; Breeding season; Colony size; Number of nests monitored; Representativeness of tracked trips; Core foraging areas (KUD50)},
}

@article{clay2023adjustment,
  author = {Clay, Thomas A and Hodum, Peter and Hagen, Erin and Brooke, M de L},
  journal = {Animal Behaviour},
  pages = {165--179},
  publisher = {Elsevier},
  title = {Adjustment of foraging trips and flight behaviour to own and partner mass and wind conditions by a far-ranging seabird},
  volume = {198},
  year = {2023},
  abstract = {Outbound and return journeys appeared to broadly benefit from predictable southeasterly trade and westerly winds, respectively. Over finer scales, departure bearings were influenced by wind directions. Across trips, birds oriented predominantly with quartering tail winds which maximized ground speeds. Individuals experienced variable support from tail winds, and those that benefited more on outbound journeys (when winds were generally weaker) travelled faster, reached foraging areas more quickly and, over the entire trip, had higher mass gain per day at sea.},
  analytical_methods = {Deploy GPS and immersion loggers on incubating birds and weigh each tracked bird and its partner; Filter locations implying flight speeds above 90 km/h and interpolate tracks to 40 min intervals; Link GPS fixes to ERA5 reanalysis wind data; Fit multivariate hidden Markov models with three states (directed flight, area-restricted search, rest) from step lengths and turning angles, using the Viterbi algorithm; Calculate 50% kernel utilisation distributions of foraging areas and compare them with wind climatology; Model departure bearings with circular-circular regression; Test effects on trip duration, maximum range, path sinuosity, and mass gain with generalized additive models},
  category = {Background},
  equations = {Wind speed (Vw) as the vector magnitude of the zonal and meridional wind components; Wind direction (qw) as the two-argument arctangent of those components, expressed in degrees},
  island = {Isla Alejandro Selkirk, Juan Fern\'andez Archipelago, Chile},
  keywords = {Body condition; Gadfly petrel; Hidden Markov model; Incubation; Mass gain; Movement ecology; Pair coordination; Pterodroma; Wind},
  limitations = {Mass of partners for birds returning above 600 g was back-calculated from a daily mass loss estimate instead of measured directly; Five individuals could not be reweighed before fieldwork ended, reducing the sample size for return mass and mass gain; The group carrying geolocator-immersion loggers only had a particularly small sample size; The observational design and modest sample size do not allow between-pair and within-pair effects to be separated; At 40 min GPS resolution, finescale foraging behaviour may be unresolved},
  objectives = {Classify at-sea behavioural states with hidden Markov models and compare routes with mean wind conditions to test the prediction of large-scale anticlockwise looping trips that follow prevailing winds (H1a); Test how finely birds tune routes and flight behaviour to the wind they encounter, including departure bearings (H1b--H1d); Test whether own and partner mass influence trip duration, maximum range, and mass gain (H2a, H2b); Test whether more efficient use of tail winds increases trip success, measured as trip duration and mass gain (H3)},
  research_question = {It is little known how Juan Fern\'andez petrels adjust their foraging trips and flight behaviour to wind conditions and to their own and their partner's mass during breeding},
  results = {Trips averaged 20.4 days and 10741 km; Foraging areas lay about 3400 km west of the colony in the southeastern Pacific Ocean; Birds spent 45.8% of time in directed flight (SD 7.5%), 40.0% in area-restricted search (SD 4.9%), and 14.2% resting (SD 3.6%); Outbound and return legs followed southeasterly trade and westerly winds respectively; Birds gained around a quarter of their departure mass; Birds lighter on departure gained more mass; Birds with heavier partners ranged further, contrary to prediction; Greater outbound tail wind support brought faster travel and higher daily mass gain, but not shorter trips or more total mass},
  software = {R v4.0.3; momentuHMM; adehabitatLT; trip; track2kba; raster; fields; adehabitatHR; circular; mgcv; maptools; multcomp; lmtest},
  species = {Juan Fern\'andez petrel},
  time_period = {December 2019 to February 2020},
  variables = {Departure and return mass of tracked birds; Mass of the partner at departure; Zonal and meridional wind components, wind speed, and wind direction; Average tail wind support (Vtw); Ground speed; Trip duration; Maximum range from the colony; Cumulative distance travelled; Path sinuosity; Time spent in directed flight, area-restricted search, and rest; Immersion activity as a proxy for prey capture; Foraging area as the 50% kernel utilisation distribution of area-restricted search locations},
}

@article{copello2014spatial,
  author = {Copello, Sof\'ia and Pon, Juan Pablo Seco and Favero, Marco},
  journal = {Journal of Sea Research},
  pages = {44--51},
  publisher = {Elsevier},
  title = {Spatial overlap of Black-browed albatrosses with longline and trawl fisheries in the Patagonian Shelf during the non-breeding season},
  volume = {89},
  year = {2014},
  abstract = {The overlap index showed highest values with both coastal fleets, followed by the ice-chilling trawl fleet. These intersections were located in the Argentine-Uruguay Common Fishing Zone, in coastal areas of the SE of Buenos Aires province, El Rinc\'{o}n estuary and over the shelf break. The analysis of intersections of focal areas from albatrosses and all fisheries allowed us the identification of thirty-four fishing management units (1 degree by 1 degree grid within the Argentine EEZ) classified as of medium, high or very high conservation priority.},
  analytical_methods = {Filter Argos locations by flight speed and re-sample tracks at 30 min intervals; Filter vessel monitoring system positions by speed and time of day to represent fishing effort; Model at-sea distributions of birds and fleets with kernel utilization distributions, a 50 km smoothing parameter, and 50%, 75%, and 95% contours; Quantify overlap with the utilization distribution overlap index and compare with a Kruskal-Wallis test; Intersect bird and fleet utilization distributions as a proxy of mortality risk; Aggregate the 75% focal intersections into a 1 degree grid, weighting cells by surface covered and classifying medium, high, or very high risk},
  category = {Similar work},
  equations = {Utilization distribution overlap index (UDOI) of Fieberg and Kochanny (2005), bounded between 0 and 1; Grid risk weight as the proportion of a management unit surface covered by the 75% focal area intersection},
  island = {Argentine Patagonian Shelf and Argentine-Uruguay Common Fishing Zone, Argentina},
  keywords = {Thalassarche melanophris; Argentine fisheries; Vessel monitoring system; Satellite tracking; At sea distribution; Conservation priority areas},
  limitations = {Only 11 birds were tracked, so the sample size is limited; Captures for tag deployment occurred at two locations in central-north Patagonia (38 degree S and 42 degree S), which may have caused underestimation or no identification of risk areas in southern waters, in particular to the south of breeding sites},
  objectives = {Model the degree of spatial overlap between Black-browed albatrosses and the Argentine fisheries known to pose a threat, using satellite telemetry and vessel monitoring system data; Compare the at-sea distributions of birds and of six fleets with kernel utilization distributions and quantify overlap with the utilization distribution overlap index; Identify the locations where bird and fleet focal areas intersect; Classify 1 degree by 1 degree management units of the Argentine EEZ by the extent of overlap to identify areas of medium, high, and very high conservation priority},
  research_question = {It is unknown how much the non-breeding distribution of Black-browed albatrosses overlaps the different Argentine fishing fleets, and therefore where conservation effort is most needed},
  results = {4,863 fixes from 11 birds tracked up to 107 days; Birds ranged from 29 to 51 degree S, off Argentina, Uruguay, and southern Brazil; Overlap was highest with coastal trawlers (UDOI 50% = 0.012 and 0.013) and ice-chilling trawlers (0.010), and there was none with demersal longliners; Differences were significant only between longliners and both coastal fleets (P < 0.05); Thirty-four 1 degree management units, 17% of those in the EEZ, were of medium, high, or very high priority; Very high priority units lay at the mouth of the Rio de la Plata and east of the hake closure},
  software = {R 2.15; adehabitat; ArcGIS 10.0; Argos System; Satellite Tracking and Analysis Tool},
  species = {Black-browed albatross},
  time_period = {Austral winters (June--September) 2011 and 2012 for bird tracking; winter 2011 for vessel monitoring system data},
  variables = {Albatross at-sea position fixes; Vessel monitoring system positions of fishing vessels; Fishing effort by fleet; Kernel utilization distribution core (50%), focal (75%), and range (95%) areas of birds and of fleets; Utilization distribution overlap index (UDOI); Proportion of each 1 degree by 1 degree management unit covered by the bird-fishery intersection; Conservation priority class (medium, high, very high)},
}

@article{critchley2018marine,
  author = {Critchley, Emma Jane and Grecian, W James and Kane, Adam and Jessopp, Mark J and Quinn, John L},
  journal = {Biological Conservation},
  pages = {309--317},
  publisher = {Elsevier},
  title = {Marine protected areas show low overlap with projected distributions of seabird populations in Britain and Ireland},
  volume = {224},
  year = {2018},
  abstract = {Marine Protected Areas (MPAs) are an important tool for the conservation of seabirds. However, mapping seabird distributions using at-sea surveys or tracking data to inform the designation of MPAs is costly and time-consuming, particularly for far-ranging pelagic species. Here we explore the potential for using predictive distribution models to examine the effectiveness of current MPAs for the conservation of seabirds, using Britain and Ireland as a case study.},
  analytical_methods = {Collate open-access colony data for 25 breeding species from the JNCC Seabird Monitoring Programme; Project distributions on a 5 by 5 km grid by inverting distance from colony, normalising to 0--1, weighting by the inverse log distance from the colony, and assuming 50% of a breeding pair forages at sea; Exclude land so birds cannot cross it; Sum across colonies, species, eight family groups, and two foraging range groups, splitting coastal from pelagic at a 75 km maximum foraging range; Merge protected area polygons by type to avoid double counting; Test overlap differences with a Wilcoxon rank sum test},
  category = {Similar work},
  equations = {Distance-decay weighting of grid cells by the inverse log distance from the colony; Not applicable otherwise, the approach is described in five procedural steps rather than formulae},
  island = {Britain and Ireland},
  keywords = {Seabirds; Protected areas; Predictive modelling; Hotspots; Foraging; Ecosystem approach},
  limitations = {Projection models cannot account for spatio-temporal variation in oceanic, meteorological, and ecological factors, so patchy resource distribution and variable prey availability are not represented; The proportion of a population at sea varies with time of day and season, so values are representative only of the period when most foraging occurs; About 3% of colonies had not been censused in the last 30 years; Protected areas near colonies do not necessarily serve the species needing most protection, since most foraging by pelagic species occurs offshore},
  objectives = {Project at-sea distributions for the whole seabird community of Britain and Ireland using a distance-weighted foraging radius approach; Identify hotspots of highest density and species richness; Quantify the percentage overlap between projected distributions and existing protected areas at the level of species, family group, foraging range group, and conservation status; Compare overlap between coastal and pelagic foragers and between threatened and non-threatened species},
  research_question = {Whether predictive distribution models can assess the effectiveness of existing marine protected areas for seabirds when mapping at-sea distributions with surveys or tracking data is too costly, particularly for far-ranging pelagic species},
  results = {Overlap was significantly higher for coastal species (mean 32.5%) than for pelagic species (13.2%, p < 0.001); The difference held under SPAs (18.1% against 2.4%) and OSPAR MPAs (25.5% against 11.9%); Non-threatened species had higher coverage than threatened species (25.0% against 14.3%), significant for SPAs (p = 0.01) but not for OSPAR MPAs (p = 0.09) or all protected areas (p = 0.07); Species overlap ranged from under 7% (European storm-petrel) to over 70% (Mediterranean gull)},
  software = {R version 3.2.1; ggplot2 version 2.00},
  species = {All seabird species breeding in Britain and Ireland (25 species)},
  time_period = {Breeding season; colony counts from most recent censuses, about 3% uncensused in the last 30 years},
  variables = {Colony location; Colony population size; Maximum foraging range; Foraging range group (coastal or pelagic); European conservation status; Proportion of the European population in Britain and Ireland; Projected number of individuals per grid cell; Species richness per grid cell; Protected area type (SPA, OSPAR MPA); Percentage of the projected at-sea population inside protected areas},
}

@article{croxall2012seabird,
  author = {Croxall, John P and Butchart, Stuart HM and Lascelles, BEN and Stattersfield, Alison J and Sullivan, BEN and Symes, Andy and Taylor, PHIL},
  journal = {Bird Conservation International},
  number = {1},
  pages = {1--34},
  publisher = {Cambridge University Press},
  title = {Seabird conservation status, threats and priority actions: a global assessment},
  volume = {22},
  year = {2012},
  abstract = {We review the conservation status of, and threats to, all 346 species of seabirds, based on BirdLife International's data and assessments for the 2010 IUCN Red List. We show that overall, seabirds are more threatened than other comparable groups of birds and that their status has deteriorated faster over recent decades. The principal current threats at sea are posed by commercial fisheries (through competition and mortality on fishing gear) and pollution, whereas on land, alien invasive predators, habitat degradation and human disturbance are the main threats.},
  analytical_methods = {Review of BirdLife International assessments for the 2010 IUCN Red List; Classification of 346 species into pelagic and coastal groups; Country analyses excluding vagrant records; GIS and digitised distribution maps for Exclusive Economic Zones, Large Marine Ecosystems and Regional Fisheries Management Organisations; IUCN/CMP threats classification with magnitude from timing, scope and severity; IUCN/CMP actions coding},
  category = {State of the art},
  equations = {not_applicable},
  island = {Global},
  keywords = {not_applicable},
  limitations = {Analyses are global and should be supplemented by regional reviews because regional extinction-risk assessments are largely lacking; Population estimates for many sites are of low quality with broad uncertainty; Four species are Data Deficient; Knowledge gaps remain on aquaculture, energy generation and climate change},
  objectives = {Provide a global overview of the status of seabird species, especially globally threatened and Near Threatened species, in relation to jurisdictional responsibility; Identify the main reasons why seabirds are threatened; Review priority actions to address the main threats; Indicate priorities for research and monitoring and identify knowledge gaps},
  research_question = {At present there is no readily accessible and up-to-date synthesis of the conservation status of the world's seabirds.},
  results = {Of 346 species, 97 (28 percent) are threatened, 17 (5 percent) Critically Endangered and 10 percent Near Threatened; Seabirds are more threatened than parrots (26 percent), pigeons (19 percent), raptors (18 percent) and the global average (12 percent); Penguins and albatrosses and petrels, 43 percent of species, are the most threatened groups; Of 132 threatened or Near Threatened species, 70 (53 percent) qualify by small population or range and 66 (50 percent) by rapid decline; Priority actions are site protection, removal of invasive predators and reduction of bycatch},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {2010},
  variables = {Red List category; Population trend; Threat type and magnitude; Jurisdiction; Species distribution; Number of species},
}

@article{curk2024integrating,
  author = {Curk, T and Melzheimer, J and Aschenborn, O and Amar, A and Kolberg, H and Garbett, R and Maude, G and Reading, RP and Selebatso, M and Berzaghi, F and others},
  doi = {10.1111/acv.12980},
  journal = {Animal Conservation},
  publisher = {Wiley Online Library},
  title = {Integrating threat mapping and animal movement data to identify high-risk areas for endangered mobile species},
  url = {https://doi.org/10.1111/acv.12980},
  year = {2024},
  abstract = {We identified poisoning hotspots in northern Botswana and south-eastern Namibia. These areas were also associated with a high number of vulture mortalities, providing additional support for poisoning risk. Northern Botswana and areas at the border between Botswana and South Africa were characterized by high food availability, potentially amplifying the mortality rate by attracting vultures from surrounding areas.},
  analytical_methods = {Capture 20 adult vultures with solar GPS tags and retain 19, thinning positions to 2 h daytime intervals; Estimate annual utilisation distributions from 52 annual trajectories with a dynamic Brownian bridge movement model; Extract poisoning and food availability at each utilisation value, rescaling rasters to 0 to 1 and summing utilisation per cell into occupation probabilities; Fit generalized linear mixed models with a beta family, averaging 10 models with one random annual trajectory per individual; Fit quasi-Poisson generalized linear models for vulture numbers per cell; Test sensitivity to extrapolated Botswana poisoning values},
  category = {Key concepts},
  equations = {not_applicable},
  island = {Northern Botswana, south-eastern Namibia, and the border between Botswana and South Africa, Southern Africa},
  keywords = {GPS tracking; Human-wildlife conflict; Resource availability; Sentinel poisoning; Space use; Torgos tracheliotos; Vultures; Poisoning risk},
  limitations = {Unintentional poisoning data were unavailable for Botswana and were extrapolated from the best knowledge available, so this extrapolation should be borne in mind when interpreting results; The food availability layer includes livestock and wild herbivores but not butcheries or vulture restaurants, which are expected to affect vulture movements; Identified hotspots depend on the space use of the study species, so the number of individuals, populations and species included affects the results},
  objectives = {Introduce a framework for quantifying exposure of mobile species to spatially explicit threats; Illustrate the framework with poisoning risk in the Lappet-faced vulture; Combine GPS tracking with food availability and intentional and unintentional poisoning maps across Southern Africa; Identify poisoning hotspots and test whether space use and vulture numbers increase with poisoning and food availability; Test sensitivity to the extrapolated unintentional poisoning values for Botswana},
  research_question = {How can the spatial exposure of mobile species to anthropogenic threats be quantified and mapped, illustrated with poisoning risk to an endangered vulture species},
  results = {Poisoning hotspots in northern Botswana and south-eastern Namibia were also associated with high numbers of vulture mortalities; The largest exposure to intentional poisoning was in north-eastern, central and south-western Botswana; Northern Botswana and the border with South Africa had high food availability, potentially amplifying mortality; Vultures spent similar time in low and high poisoning and food availability areas individually, but the number of vultures was significantly higher in high unintentional poisoning under low food availability, and in high intentional poisoning under high food availability; Hotspots occurred mainly because many individuals used them rather than one intensively},
  software = {move; raster; glmmTMB; AER},
  species = {Lappet-faced vulture},
  time_period = {GPS tracking 2012 to 2022; poisoning records 2000 to 2023},
  variables = {Individual space use as a proportional probability of occupying a 10 km cell; Number of vultures occupying a cell; Intentional poisoning prevalence; Unintentional poisoning prevalence; Food availability; Reported vulture mortalities; Individual annual trajectory identity as a random effect},
}

@article{dias2019threats,
  author = {Dias, Maria P and Martin, Rob and Pearmain, Elizabeth J and Burfield, Ian J and Small, Cleo and Phillips, Richard A and Yates, Oliver and Lascelles, Ben and Borboroglu, Pablo Garcia and Croxall, John P},
  journal = {Biological Conservation},
  pages = {525--537},
  publisher = {Elsevier},
  title = {Threats to seabirds: a global assessment},
  volume = {237},
  year = {2019},
  abstract = {We present the first objective quantitative assessment of the threats to all 359 species of seabirds, identify the main challenges facing them, and outline priority actions for their conservation. We applied the standardised Threats Classification Scheme developed for the IUCN Red List to objectively assess threats to each species and analysed the data according to global IUCN threat status, taxonomic group, and primary foraging habitat (coastal or pelagic).},
  analytical_methods = {Selection of all 359 seabird species under the BirdLife International taxonomy; Bibliographic search in Web of Knowledge and Google Scholar; Threat coding with the IUCN Red List Threats Classification Scheme version 3.2 down to level 3; Scoring of timing, scope and severity; Refinement of the scheme to separate bycatch from overfishing and invasive species from disease; Impact as mean scope times mean severity, ranked low to very high; Bootstrap with 1000 repetitions for 95% confidence intervals},
  category = {State of the art},
  equations = {Impact score as mean scope multiplied by mean severity; Total birds exposed as the sum of species abundance multiplied by threat scope},
  island = {Global},
  keywords = {Conservation; Globally threatened species; Human impacts; Marine birds},
  limitations = {Impact scores for bycatch and overfishing assumed equal for the 34 species affected by both; Global abundance estimated by multiplying mature individuals by 1.5, with mature individuals available for 95% of species; Wide ranges of abundance and scope estimates},
  objectives = {Identify the main ongoing drivers of population declines of seabirds globally; Provide the first systematic appraisal of the overall impacts of each threat on multiple species; Quantify the number of individual seabirds exposed to each threat; Highlight the challenges and priority actions needed to improve the conservation status of seabirds},
  research_question = {No objective quantitative assessment had covered the threats affecting all seabird species worldwide, and the only global review used data up to 2010 and addressed only globally threatened species.},
  results = {Invasive alien species affected 165 species; Bycatch affected 100 species with the greatest average impact; Climate change affected 96 species; Overfishing, hunting/trapping and disturbance were also major threats; 301 of 359 species (84%) face at least one ongoing threat; About 70% face two or more threats and 46% three or more; More than 380 million birds (about 45% of all seabirds) are exposed to at least one of the top three threats; 90% of albatross species are affected by bycatch},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {Up to 2019},
  variables = {Threat timing; Threat scope; Threat severity; Number of species affected; Mean and overall impact of each threat; Number of individual birds exposed; IUCN Red List status; Taxonomic group; Primary foraging habitat; Global population trend; Fishing gear and fishery scale for bycatch},
}

@incollection{duffy1994seabird,
  author = {Duffy, David C and Schneider, David C},
  booktitle = {Seabirds on islands: threats, case studies and action plans. BirdLife Conservation Series},
  pages = {26--38},
  title = {Seabird-fishery interactions: a manager's guide},
  volume = {1},
  year = {1994},
  abstract = {Decisions about the conservation of seabirds are necessarily taken in an economic and political context; and because of limited information decisions typically must be made where uncertainty is great. We examine the consequences of Type I uncertainty (believing that interaction occurs when none is present) and Type II uncertainty (believing no interaction occurs when it does). Many interactions detrimental to seabirds are incidental rather than directed at birds; this suggests that enlisting fishermen as allies would be an effective alternative to regulatory steps.},
  analytical_methods = {Literature review of seabird-fishery interactions; Division of conflicts into direct mortality and competition; Direct measurement of mortality at fishing operations and counts of dead birds; Extrapolation of mortality per operation to the whole fishery; Comparison of fishery mortality with population size and annual reproduction; Three approaches to competition: consumption ratios, population studies, and reproduction and diet studies; Five ratios calculated from bird numbers, intake, diet, stock, production and landings; Flow chart of the ratios},
  category = {Classic},
  equations = {Horn ratio of dietary overlap based on the Morisita index; Evans ratio of seabird catch to prey stock; Wiens ratio of seabird catch to prey production; Schaefer ratio of seabird catch to fishery catch; Bourne ratio of seabird catch to lateral resupply},
  island = {Global},
  keywords = {not_applicable},
  limitations = {Decisions must be made where information is limited and uncertainty is great; Observer presence may bias mortality measurements; Counts of dead birds are minimum estimates because carcasses sink or drift away; Ratio precision cannot exceed the precision of the least-known variable; Extrapolating breeding-season diets to the whole year can give erroneous results},
  objectives = {Review the diversity of seabird-fishery interactions; Discuss practical means of detecting and estimating them; Assess available management options; Suggest managerial approaches that limit damage even when the wrong decision is made; Examine the economic and political limits to management},
  research_question = {Most attention had gone to accidental deaths and competition, although fishing activities affect seabirds in many other ways.},
  results = {Evans ratios ranged from 0.06 in the North Sea to 0.16 for Peruvian anchoveta, with 0.23 around a Benguela colony; Wiens ratios ranged from 0.035 to 0.42; Values below 0.10 for either ratio suggest that seabirds are minor consumers of commercial prey; Fishery mortality near the level of reproduction signals a crisis, and even 10% of reproduction signals a strong possibility of a problem; Small-scale fisheries take 27 million of the 49 million tonnes of world catch and employ 95% of 10.5 million fishermen},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {Dietary overlap between seabirds and fishery landings; Seabird catch in tonnes; Prey stock mass; Prey production; Fishery catch; Lateral resupply; Bird population size; Daily intake per bird; Share of the prey species in the diet; Fishery mortality relative to reproduction; Economic and political costs of regulation},
}

@article{fauchald2003using,
  author = {Fauchald, Per and Tveraa, Torkild},
  journal = {Ecology},
  number = {2},
  pages = {282--288},
  publisher = {Wiley Online Library},
  title = {Using first-passage time in the analysis of area-restricted search and habitat selection},
  volume = {84},
  year = {2003},
  abstract = {We used simulated pathways and satellite tracking of a long-ranging seabird to explore the properties of first-passage time as a measure of search effort along a path. The first-passage time is defined as the time required for an animal to cross a circle with a given radius. It is a measure of how much time an animal uses within a given area. First-passage time is scale dependent, and a plot of variance in first-passage time vs. spatial scale reveals the spatial scale at which the animal concentrates its search effort.},
  analytical_methods = {Simulated area-restricted search and correlated random walk pathways; Satellite transmitters on incubating Antarctic petrels; Linear interpolation of positions every 2 km; Relative variance in first-passage time against radius; Selection of the radius with the highest variance; Grid averaging of log first-passage time; Spatial cross-correlation between trips; Nested small-scale analysis},
  category = {Methods},
  equations = {First-passage time; Relative variance in first-passage time; Spatial cross-correlation function},
  island = {Svarthamaren, Dronning Maud Land, Antarctica},
  keywords = {Animal movement; Antarctic Petrel; Dispersal; First-passage time; Hierarchical foraging; Radio tracking; Random walk; Satellite telemetry; Scale; Search pattern; Thalassoica antarctica},
  limitations = {The sample of four trips excluded statistical inference at the population level; One transmitter was excluded for technical problems; A single scale-variance plot cannot easily separate area-restricted search from correlated random walk; Error near the maximum depends on tortuosity},
  objectives = {Explore the properties of first-passage time as a measure of search effort along a path; Determine the spatial scale at which an animal concentrates its search effort; Relate first-passage time to environmental variables and the search pattern of other individuals},
  research_question = {To understand the underlying behavioral mechanisms involved, there is a need for methods to measure changes in movement patterns along a pathway through the landscape.},
  results = {For simulated area-restricted search, the maximum variance fell near the patch diameter, while correlated random walks increased and levelled off; For the petrels, trips 2 and 4 peaked at about 240 and 150 km and spent about 7 and 3 days in the most searched area; Trips 1 and 3 showed low variance and no clear peak; Nested analysis found peaks at about 40 and 20 km; Search effort overlapped among trips 1, 2 and 4; Four trips came from five transmitters},
  software = {not_applicable},
  species = {Antarctic petrel},
  time_period = {1997},
  variables = {First-passage time; Radius; Variance in log first-passage time; Search effort; Spatial correlation; Environmental variables},
}

@article{fieberg2005quantifying,
  author = {Fieberg, John and Kochanny, Christopher O},
  journal = {The Journal of Wildlife Management},
  number = {4},
  pages = {1346--1359},
  publisher = {Wiley Online Library},
  title = {Quantifying home-range overlap: the importance of the utilization distribution},
  volume = {69},
  year = {2005},
  abstract = {We illustrate the importance of the utilization distribution in characterizing the degree of overlap between home ranges (e.g., when assessing site fidelity or space-use sharing among individuals). We compare several different statistics for their ability to accurately rank paired examples in terms of their degree of overlap. These examples illustrate limitations of indices commonly used to quantify home-range overlap and suggest that new overlap indices that are a function of the UD are likely to be more informative.},
  analytical_methods = {Comparative review of HR, PHR, rs, VI, BA and UDOI; Paired examples computing each index on constructed utilization distributions; Simulation with 4 distributions built from mixtures of 3 multivariate normal distributions; 3 sample sizes and 1000 replicated pairs per combination; Kernel density estimates with a Gaussian kernel and plug-in bandwidths; Home ranges and indices on a 150 by 150 grid with conditional 95% distributions; GPS and VHF data from one adult female deer compared with the same indices},
  category = {Methods},
  equations = {HR, proportion of a home range overlapped; PHR, probability of an animal being located in another home range; Conditional utilization distribution; VI, volume of intersection; BA, Bhattacharyya's affinity; UDOI, utilization distribution overlap index},
  island = {North-central Minnesota, USA},
  keywords = {Bhattacharyya's affinity; Global Positioning System; home range; overlap; static interaction analysis; telemetry; utilization distribution; utilization distribution overlap index; volume of intersection statistic},
  limitations = {One simulation study only, so the authors hesitate to generalize; Bias may depend on the distributions compared, the estimator and the smoothing parameter; Confidence limits for the true indices are difficult to determine; Only static interaction analyses were considered; The indices assume an accurate and precise estimate of each animal's utilization distribution},
  objectives = {Provide a comparative review of commonly used overlap indices; Review metrics used to quantify home-range overlap and suggest alternative indices; Use paired examples to illustrate computation of the indices and facilitate their comparison; Assess the properties of the indices with a simulation study; Illustrate the indices by comparing utilization distributions from GPS and VHF data for one deer},
  research_question = {Although several indices had been proposed for quantifying home-range overlap, they had rarely been compared.},
  results = {Area-based ranking was correct in 58% of simulations at n = 40, 75% at n = 150 and 96% at n = 500; Probability-based measures, VI, BA and UDOI ranked correctly over 80% of the time at n = 40 and nearly 100% at n = 150; Estimates were biased low when overlap was high, and bias fell as sample size rose; For the deer, VI was 0.59 while BA was 0.80 and UDOI 0.88; GPS and VHF home ranges were 97 and 82 ha},
  software = {R; XYLOG},
  species = {White-tailed deer},
  time_period = {1999-2000},
  variables = {Home-range area; Area of overlap; Utilization distribution; Proportion of home range overlapped; Probability of being located in another home range; Volume of intersection; Bhattacharyya's affinity; Utilization distribution overlap index; Bias of overlap estimates; Sample size; Degree of overlap},
}

@article{furness1997seabirds,
  author = {Furness, Robert W and Camphuysen, Kees},
  journal = {iceS Journal of marine Science},
  number = {4},
  pages = {726--737},
  publisher = {Oxford University Press},
  title = {Seabirds as monitors of the marine environment},
  volume = {54},
  year = {1997},
  abstract = {Many studies have shown that seabirds are sensitive to changes in food supply, and therefore have potential as monitors of fish stocks. For most seabird species breeding parameters suitable for biomonitoring have yet to be measured over a wide range of prey densities. However, it is clear that responses vary among species and care must be taken when interpreting seabird data as a proxy for fish abundance. For many years seabirds have also been used as monitors of pollution, especially oil pollution.},
  analytical_methods = {Review of published studies; Beached bird surveys; Chemical fingerprinting of oil; Feather mercury analysis; Stable isotope analysis of nitrogen and carbon},
  category = {State of the art},
  equations = {not_applicable},
  island = {Global},
  keywords = {Biomonitors; Fish stocks; Mercury; Oil pollution; Pollution; Seabirds; Stable isotopes},
  limitations = {Responses vary among species and care is needed when interpreting seabird data as a proxy for fish abundance; Mercury trends depend on the assumption that diet composition has not changed; Some unexpected mercury results cannot yet be explained},
  objectives = {Review the use of seabirds as biomonitors of the marine environment; Assess breeding parameters as monitors of fish stocks; Assess beached bird surveys and oil fingerprinting as monitors of oil pollution; Assess feather mercury and stable isotopes as monitors of heavy metal pollution},
  research_question = {For most seabird species breeding parameters suitable for biomonitoring have yet to be measured over a wide range of prey densities.},
  results = {Beached bird surveys in the Netherlands found 88 percent of birds contaminated by oil, while the oil rate in Shetland was 18 percent; Oil release into the southern North Sea declined consistently over the last 15 years; Mercury contamination increased over the last 150 years, with the greatest increases in seabirds feeding on mesopelagic prey; High mercury levels in north Iceland remain unexplained},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {Breeding parameters; Breeding success; Activity budgets; Diet composition; Oil rates on beaches; Mercury concentrations; Stable isotope ratios},
}

@article{good2020national,
  author = {Good, SD and Baker, GB and Gummery, M and Votier, SC and Phillips, RA},
  journal = {Biological Conservation},
  pages = {108592},
  publisher = {Elsevier},
  title = {National Plans of Action (NPOAs) for reducing seabird bycatch: Developing best practice for assessing and managing fisheries impacts},
  volume = {247},
  year = {2020},
  abstract = {We reviewed NPOAs to identify approaches taken to determine whether seabird bycatch is problematic, how bycatch minimisation and population objectives are set, and if thresholds are specified for managing impacts. Our aim was to recommend measures for improving consistency and effectiveness in future NPOAs and other management frameworks for seabirds, with relevance for other threatened marine vertebrates including sharks, turtles, pinnipeds and cetaceans.},
  analytical_methods = {Review of the 2014 COFI survey responses; Identification of NPOA documents available online from links in Cooper (2019); Extraction of the method used to identify a bycatch problem, the objectives, the thresholds and their link to management; Coding of approaches as qualitative, semi-quantitative or fully quantitative; Assessment against criteria from the FAO guidelines and literature; Comparison of NPOAs against best-practice elements},
  category = {State of the art},
  equations = {not_applicable},
  island = {Global},
  keywords = {Bycatch; Seabirds; Fisheries management; Incidental mortality; National Plan of Action (NPOA) - Seabirds},
  limitations = {The 2014 COFI survey covered only longline fisheries, although 46 states also reported trawl or gillnet fisheries},
  objectives = {Review NPOAs to identify approaches taken to determine whether seabird bycatch is problematic; Review how bycatch minimisation and population objectives are set; Review whether thresholds are specified for managing impacts; Recommend measures for improving consistency and effectiveness in future NPOAs and other management frameworks for seabirds},
  research_question = {The international plan of action is ambiguous about the steps and objectives, which weakens it as a conservation tool.},
  results = {77 COFI members responded, 67 reported longline fishing, 24 assessed the need for an NPOA and 17 found one was needed; 16 NPOAs from 14 states or entities were reviewed; 94% had an overarching bycatch objective but only 27% were specific and measurable; 19% set thresholds for management action; 88% relied on expert workshops or qualitative judgement; Only four NPOAs used explicit criteria for identifying a problem},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {2001-2019},
  variables = {Criteria used to determine whether a bycatch problem exists; Overarching bycatch objective; Population objectives; Thresholds for management action; Link between thresholds and management response; Qualitative, semi-quantitative and quantitative assessment approaches; Number of NPOAs and states},
}

@article{grecian2012novel,
  author = {Grecian, W James and Witt, Matthew J and Attrill, Martin J and Bearhop, Stuart and Godley, Brendan J and Gr{\'e}millet, David and Hamer, Keith C and Votier, Stephen C},
  journal = {Biological conservation},
  pages = {43--52},
  publisher = {Elsevier},
  title = {A novel projection technique to identify important at-sea areas for seabird conservation: An example using Northern gannets breeding in the North East Atlantic},
  volume = {156},
  year = {2012},
  abstract = {Seabirds are well monitored and protected at their breeding grounds but spend most of their life at sea, where they are less well monitored and afforded little protection. In an attempt to address this dichotomy, attention has been directed toward establishing a network of marine reserves for seabirds, based largely on information from at-sea surveys and/or biotelemetry studies. Nevertheless, these approaches are costly, are typically only available for a limited number of locations, and not suitable for species that have either poor at-sea detectability or are unable to carry tracking devices.},
  analytical_methods = {Seven-step projection model; Colony sizes from Apparently Occupied Nests; Foraging distance from the density-dependent relationship with colony size; Colony-centred foraging radius intersected with a digital elevation model to exclude land; Integration of tracking data; Near-colony maintenance and transiting decay; Correction for copepod availability; Validation against tracking and ESAS survey data; Spearman rank correlation and sensitivity analysis},
  category = {Methods},
  equations = {Density-dependent foraging distance from colony size},
  island = {North East Atlantic},
  keywords = {Marine Protected Areas; Important bird areas; Biotelemetry; At-sea surveys; Predictive modelling; Foraging behaviour; Morus bassanus},
  limitations = {Models exclude the German, Norwegian and Faroese colonies; Immature birds, which may exceed 50 percent of the population, are excluded; Decay and resource weighting may not capture seabird movements adequately; Foraging distance and trip duration are not always correlated; Copepod abundance is not a direct trophic proxy for a piscivorous seabird; Remote-sensing proxies should be used cautiously},
  objectives = {Develop a technique to identify important areas for breeding seabirds based on at-sea projections from colonies; Test the ability of the models to identify at-sea hotspots against biotelemetry and at-sea survey data},
  research_question = {Seabirds are well monitored and protected at their breeding grounds but spend most of their life at sea, where they are less well monitored and afforded little protection.},
  results = {Predicted distributions for 25 gannetries totalling 299 522 breeding pairs, about 70 percent of the global population; The final model correlated with the ESAS dataset (Spearman rs = 0.459 plus or minus 0.130, p < 0.001); Earlier steps correlated weakly (rs = 0.137 and 0.126) and the uncorrected step gave rs = 0.326; Varying foraging ranges by 25 percent changed the correlation little (rs = 0.455 to 0.486); The Channel Island colonies held 7409 breeding pairs},
  software = {MATLAB R2009b; ArcGIS 9.3},
  species = {Northern gannet},
  time_period = {2003-2009},
  variables = {Colony size; Foraging distance; Foraging range; Gannet density; Copepod abundance; At-sea distribution; Spatial correlation},
}

@article{gremillet2004offshore,
  author = {Gr{\'e}millet, David and Dell$^1$Omo, Giacomo and Ryan, Peter G and Peters, Gerrit and Ropert-Coudert, Yan and Weeks, Scarla J},
  journal = {Marine Ecology Progress Series},
  pages = {265--279},
  title = {Offshore diplomacy, or how seabirds mitigate intra-specific competition: a case study based on GPS tracking of Cape gannets from neighbouring colonies},
  volume = {268},
  year = {2004},
  abstract = {How do seabirds deal with intra-specific competition for food? We addressed this question in a study of the foraging behaviour of 91 Cape gannets Morus capensis from 2 South African colonies, situated 110 km apart, using GPS and time-depth recorders. Theoretically birds should have widely overlapping foraging areas and comparable foraging characteristics. Surprisingly, the foraging areas only overlapped by 13 and 14%, and birds from the 2 colonies also showed marked differences in their foraging patterns.},
  analytical_methods = {GPS and time-depth recorders on 91 breeding adults; GPS fixes at 1 and 10 second intervals; Depth recorded every second; Kernel density on a 0.01 degree grid; Sinuosity index to separate foraging from travelling; t-tests and Mann-Whitney U tests after transformation},
  category = {Background},
  equations = {Kernel density estimate; Sinuosity index; Percentage overlap of foraging areas},
  island = {Bird Island and Malgas, South Africa},
  keywords = {Morus capensis; Wildlife telemetry; Geolocation; Home range; Habitat partitioning; Optimal foraging; Self-organisation},
  limitations = {The study considered one species and ignored inter-specific competition with cormorants, penguins, marine mammals and predatory fish; The mechanisms behind the foraging asymmetries remain to be investigated; Sex-specific foraging decisions were not considered; Wind patterns and group feeding are suggested but not demonstrated},
  objectives = {Test whether neighbouring colonies function as subcolonies with widely overlapping foraging zones and similar foraging effort; Compare the foraging characteristics of Cape gannets from Bird Island and Malgas; Analyse the impact of coloniality and intra-specific competition for food},
  research_question = {What happens when large numbers of a seabird species breed at neighbouring breeding sites (i.e. inter-colony distance is much smaller than the maximum foraging range)?},
  results = {Foraging areas overlapped by only 13 and 14 percent; Birds from the larger Malgas colony made longer trips (22.6 vs 8.5 hours), with longer flight time (7.8 vs 5.9 hours), longer paths (293 vs 228 km) and greater maximum distance (104 vs 67 km); They travelled faster (50 vs 44 km per hour), visited more foraging locations (252 vs 121) and had more sinuous paths (1.4 vs 1.1); Dives per trip (68 vs 66), maximum depth (3.4 vs 3.6 m) and dive duration did not differ},
  software = {not_applicable},
  species = {Cape gannet},
  time_period = {2002},
  variables = {Foraging trip duration; Flight time; Path length; Maximum distance from colony; Travel speed; Number of foraging locations; Path sinuosity; Dives per trip; Dive depth; Dive duration; Spatial overlap},
}

@article{gremillet2009spatial,
  author = {Gr{\'e}millet, David and Boulinier, Thierry},
  journal = {Marine Ecology Progress Series},
  pages = {121--137},
  title = {Spatial ecology and conservation of seabirds facing global climate change: a review},
  volume = {391},
  year = {2009},
  abstract = {In this review we detail the impact of climate change on marine productivity, on marine environmental stochasticity and cyclicity, and on the spatio-temporal match–mismatch of seabirds and their prey. We thereby show that global warming has a profound bottom-up impact upon marine top-predators, but that such effects have to be studied in conjunction with the (top-down) impact of human fisheries upon seabird food resources. Further, we propose seabird ecological features, such as memory effects and social constraints, that make them particularly sensitive to rapid environmental change.},
  analytical_methods = {Literature review; Synthesis of climate change impacts on marine productivity and on seabird-prey matching; Review of examples of adaptation; Definition of research priorities},
  category = {Background},
  equations = {not_applicable},
  island = {Global},
  keywords = {Fisheries; Marine protected areas; Match–mismatch; Metapopulation dynamics; Phenotypic plasticity; Regime shift; Top-down/bottom-up control},
  limitations = {Understanding of the spatial ecology of seabirds facing environmental change is still rudimentary; The quality of models depends on unknown phenotypic plasticity and potential microevolution; Long-term monitoring programmes must be maintained},
  objectives = {Detail the impact of climate change on marine productivity, environmental stochasticity and cyclicity, and the match–mismatch between seabirds and their prey; Propose seabird ecological features that make them sensitive to rapid environmental change; Provide examples of how seabirds may adapt; Define research priorities},
  research_question = {We conclude that our understanding of the spatial ecology of seabirds facing environmental change is still rudimentary, despite its relevance for the conservation of these vulnerable organisms and for the management of marine ecosystems.},
  results = {Sea surface temperature increased and net primary production decreased in 74 percent of the permanently stratified ocean; Zooplankton biomass fell by 90 percent in the California upwelling system; Fish have a thermal niche of about 2 degrees Celsius, and changes below 0.5 degrees affect growth and survival; Philopatry exceeds 80 percent in many seabirds; Global warming acts bottom-up on top predators and must be studied with the top-down impact of fisheries},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {Marine productivity; Environmental stochasticity; Cyclicity; Match–mismatch; Seabird distribution; Movements; Prey abundance; Phenotypic plasticity},
}

@article{hernandez2019sexual,
  author = {Hern\'andez Montoya, Julio C\'esar and Ju\'arez-Rodr\'iguez, Maricela and M\'endez-S\'anchez, Federico and Aguirre-Mu\~noz, Alfonso and Rojas-Mayoral, Evaristo and \'I\~nigo-Elias, Eduardo and Galina-Tessaro, Patricia and Arnaud, Gustavo and Ortega-Rubio, Alfredo},
  journal = {Animals},
  number = {6},
  pages = {364},
  publisher = {MDPI},
  title = {Sexual dimorphism and foraging trips of the Laysan albatross (Phoebastria immutabilis) on Guadalupe Island},
  volume = {9},
  year = {2019},
  abstract = {We created a logistic model using stepwise regression to predict sex based on morphological variables. This model indicated four significant morphological predictor variables (z < 0.05) and was able to successfully predict the sex of P. immutabilis individuals in more than 90% of the cases. Based on these predictor variables, a web app was developed to determine the sex of the Laysan albatross in the field, providing a non-invasive method for rapid data collection that reduces costs and handling times while improving conservation efforts.},
  analytical_methods = {Genetic sex identification from blood samples; Student's t-test for independent samples on each morphological trait; Shapiro-Wilk and Levene tests for normality and homoscedasticity; Principal component analysis; Logistic regression with stepwise selection by Akaike information criterion; Training and validation split of 80 and 20 percent repeated 2000 times; ROC curve threshold; GLMM with year and individual as random effects; Kernel density from sklearn.neighbors on a 100 by 100 grid},
  category = {Background},
  equations = {Standardized morphological measurement; Logistic model of sex probability; Linear predictor of the logistic model},
  island = {Guadalupe Island, Mexico},
  keywords = {Laysan albatross; Guadalupe Island; sexual dimorphism; foraging trips},
  limitations = {Many environmental, ecological and biological factors may constrain the foraging potential and distribution of the species; More detailed analyses are required},
  objectives = {Evaluate the existence of sexual dimorphism in Laysan albatross on Guadalupe Island; Determine which morphological traits show the greatest differentiation between males and females; Predict the sex of individuals with a minimal number of morphological input variables; Determine whether the distances travelled differ between males and females during the breeding season},
  research_question = {Sexual dimorphism has not been reported for Laysan albatross from Guadalupe Island.},
  results = {135 albatrosses were sexed, 74 females and 61 males; Males were larger than females in all morphological traits (p < 0.05); Stepwise selection retained tarsus length, cranial width, bill height and bill length; With a threshold of 0.33 the model predicted sex correctly in over 90% of cases; 36 tracked birds provided 96 trips for males and 148 for females; Trip length (F = 0.017, p = 0.917) and maximum distance (F = 0.374, p = 0.651) did not differ between the sexes},
  software = {R Studio 3.0.1; sklearn.neighbors},
  species = {Laysan albatross},
  time_period = {2014-2018},
  variables = {Sex; Body mass; Ten morphological measurements; Trip length; Maximum trip distance; Foraging distribution},
}

@article{kroodsma2018tracking,
  author = {Kroodsma, David A and Mayorga, Juan and Hochberg, Timothy and Miller, Nathan A and Boerder, Kristina and Ferretti, Francesco and Wilson, Alex and Bergman, Bjorn and White, Timothy D and Block, Barbara A and others},
  journal = {Science},
  number = {6378},
  pages = {904--908},
  publisher = {American Association for the Advancement of Science},
  title = {Tracking the global footprint of fisheries},
  volume = {359},
  year = {2018},
  abstract = {Although fishing is one of the most widespread activities by which humans harvest natural resources, its global footprint is poorly understood and has never been directly quantified. We processed 22 billion automatic identification system messages and tracked >70,000 industrial fishing vessels from 2012 to 2016, creating a global dynamic footprint of fishing effort with spatial and temporal resolution two to three orders of magnitude higher than for previous data sets.},
  analytical_methods = {Processing of 22 billion AIS messages from 2012 to 2016; A convolutional neural network to classify vessels trained on 45,441 vessels; A second neural network to detect fishing positions trained on 503 vessels; Aggregation of effort into fishing hours and kilowatt-hours; Equal-area 0.5 degree grid; Comparison with effort reported by regional fisheries management organisations; Generalised additive model accounting for spatial autocorrelation; Additive decomposition of temporal series},
  category = {Methods},
  equations = {not_applicable},
  island = {Global},
  keywords = {not_applicable},
  limitations = {The data set covers only a small proportion of the 2.9 million motorized fishing vessels; Effort in poor satellite coverage or low AIS-use EEZs was not observed, so the fished area is likely higher; Fuel subsidies may mask the true price elasticity},
  objectives = {Quantify the global footprint of fishing effort; Map its spatial and temporal patterns; Test the sensitivity of fishing to economic and environmental variation},
  research_question = {The global footprint of fishing effort is poorly understood and has never been directly quantified.},
  results = {Fishing was detected in 55% of ocean cells in 2016, and 73% under a generous assumption; Longlining was the most widespread gear at 45% of the ocean, then purse seining at 17% and trawling at 9.4%; Vessels fished 40 million hours and consumed 19 billion kWh in 2016; Five flag states accounted for more than 85% of high seas effort; Fishing effort responded weakly to net primary production (slope 0.58, 1.7% deviance) and to fuel price (elasticity -0.06)},
  software = {not_applicable},
  species = {not_applicable},
  time_period = {2012-2016},
  variables = {AIS positions; Vessel identity and class; Fishing hours; Energy expended in kilowatt-hours; Vessel length; Engine power; Gross tonnage; Net primary production; Sea surface temperature; Fuel price; Flag state; Gear type},
}

@article{lascelles2012hotspots,
  author = {Lascelles, Ben G and Langham, Gary M and Ronconi, Robert A and Reid, James B},
  journal = {Biological Conservation},
  pages = {5--14},
  publisher = {Elsevier},
  title = {From hotspots to site protection: Identifying Marine Protected Areas for seabirds around the globe},
  volume = {156},
  year = {2012},
  abstract = {Marine Protected Areas (MPAs) are recognised as a key component of an ecosystem-based approach to managing the marine environment more effectively and sustainably. Marine top predators, such as seabirds, may be used to identify and prioritize sites for marine conservation. Here we highlight the important role that seabird scientists can play in identifying candidate sites for MPAs; areas identified using at-sea surveys, seabird tracking, and species-habitat modelling.},
  analytical_methods = {Review of technological and methodological approaches; At-sea surveys; Seabird tracking; Species-habitat modelling; Hot-spot analysis; Policy review; Practical steps for MPA proposals},
  category = {Background},
  equations = {not_applicable},
  island = {Global},
  keywords = {Seabirds; Marine Protected Areas; Marine spatial planning; Convention on Biological Diversity; Conservation; Policy},
  limitations = {Traditional MPAs may not be suitable for all seabirds, since widely dispersing opportunistic feeders are difficult to delimit to specific areas or habitats; The general framework may not always apply, and proposals may need tailoring to specific agreements},
  objectives = {Outline why seabirds can be effectively used to identify candidate MPAs; Review technological and methodological approaches to identifying and prioritizing seabird hotspots; Discuss relevant policy mechanisms and the role of MPAs in marine spatial planning; Examine the practical steps required for proposing and promoting seabird sites for MPA designation},
  research_question = {Their habits at-sea often remain poorly understood and those areas most important for their survival have rarely been defined in any systematic way.},
  results = {Nearly 30 percent of about 350 seabird species are globally threatened and a further 10 percent Near Threatened; MPAs are a key component of ecosystem-based management; Candidate sites can be identified from at-sea surveys, tracking and habitat models; Boundaries should be realistic, easy to monitor and enforce, and based on long-term data; Designation needs advocacy at local, national and international levels},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {At-sea survey data; Tracking data; Habitat model outputs; Site size and shape; Monitoring and enforcement feasibility; Data duration},
}

@article{lascelles2016applying,
  author = {Lascelles, Ben G and Taylor, PR and Miller, MGR and Dias, MP and Oppel, S and Torres, L and Hedd, A and Le Corre, Matthieu and Phillips, RA and Shaffer, Scott A and others},
  journal = {Diversity and Distributions},
  number = {4},
  pages = {422--431},
  publisher = {Wiley Online Library},
  title = {Applying global criteria to tracking data to define important areas for marine conservation},
  volume = {22},
  year = {2016},
  abstract = {Tracking data provide unparalleled information on the distribution of marine taxa, but there are no agreed guidelines that ensure these data are used consistently to identify biodiversity hotspots and inform marine management decisions. Here, we develop methods to standardize the analysis of tracking data to identify sites of conservation importance at global and regional scales.},
  analytical_methods = {Compilation of tracking data from the seabird tracking database; Standardization and grouping by species, colony and life history stage; Trip identification; Test for pseudo-replication using Hausdorff distances and Mann-Whitney U-tests with 100 repetitions and alpha 0.25; First Passage Time analysis to select the kernel smoothing parameter; Kernel utilization distribution per trip and 50% core-use areas; Grid of 0.01 degrees; Subsampling analysis of representativeness; Multiplication of colony size by tracked proportion and a 0.75 correction factor; Scoring against IBA criteria A1, A4ii and A4iii},
  category = {Methods},
  equations = {Hausdorff distance between core-use areas; Mann-Whitney test of within and between individual distances; Population estimate as colony size times tracked proportion times correction factor},
  island = {Global},
  keywords = {Important Bird and Biodiversity Areas; kernel analysis; marine protected areas; seabirds; site-based conservation; tracking data},
  limitations = {Most data came from medium-sized and large procellariiform species, 93% of data groups; Applying the method to smaller or less mobile species requires different trip definitions and species-specific settings; Further sensitivity analyses of the thresholds are needed},
  objectives = {Develop methods to standardize the analysis of tracking data to identify sites of conservation importance at global and regional scales},
  research_question = {There are no agreed guidelines that ensure tracking data are used consistently to identify biodiversity hotspots and inform marine management decisions.},
  results = {125 deployments at 55 locations covered 60 species over 1992 to 2012; 252 data groups held more than 8000 tracks and 2 million points; 1052 polygons were defined for 52 species, with a mean of 4.4 per data group; The criteria were triggered 715 times for A1, 689 for A4ii and 130 for A4iii; 48 data groups (19%) were inadequate, including 22 that were not representative; The sites covered 4.3% of the ocean, about 17 million square kilometres},
  software = {R},
  species = {Seabirds},
  time_period = {1992-2012},
  variables = {Tracking device type; Species; Colony; Life history stage; Data group; Core-use area of each trip; Kernel smoothing parameter; Area-restricted search scale; Pseudo-replication; Representativeness; Number of trips; Colony size; IBA criteria thresholds; Overlap of polygons},
}

@article{lewison2003estimating,
  author = {Lewison, Rebecca L and Crowder, Larry B},
  journal = {Ecological Applications},
  number = {3},
  pages = {743--753},
  publisher = {Wiley Online Library},
  title = {Estimating fishery bycatch and effects on a vulnerable seabird population},
  volume = {13},
  year = {2003},
  abstract = {Here we present a case study of quantifying bycatch from a basin-wide pelagic longline fishery and assessing the population-level impact on a vulnerable seabird, the Black-footed Albatross (Phoebastria nigripes) in the central North Pacific. We develop an assessment method that uses observer data to estimate bycatch for one fleet and then uses scenario analysis to estimate bycatch for remaining fleets. Our method generates a bounded estimate of bycatch within an ocean region, ranging from the worst-case to the best-case bycatch scenario.},
  analytical_methods = {NMFS observer data from 1994 to 2000; Three estimators, the per hook two-stage estimator, the Pennington estimator and CART regression trees; Three seasonal strata; Three areas of co-occurrence; Scenario analysis for international fleets; Age-structured matrix population model; Bootstrap of 1000 replications},
  category = {Methods},
  equations = {Two-stage per hook estimator; Pennington estimator; CART regression tree; Age-structured matrix model; Population growth rate lambda},
  island = {Central North Pacific},
  keywords = {Albatross; Bycatch; Fisheries impact; Mortality; Pelagic longline fisheries; Phoebastria nigripes; Population effects; Seabird},
  limitations = {The analysis requires extensive estimation and extrapolation from existing data; Observer coverage is only 3 to 5 percent of trips; The variance of annual estimates is high; International effort data do not identify nations or vessels},
  objectives = {Quantify bycatch from a basin-wide pelagic longline fishery; Assess the population-level impact on the Black-footed albatross; Develop an assessment method using observer data and scenario analysis},
  research_question = {Because pelagic longline fisheries involve multinational fleets operating in vast ocean regions, assessing total bycatch levels for a seabird is challenging.},
  results = {The U.S. Hawaii fleet killed about 2000 birds per year (bootstrap mean 1847, interval 1544 to 2286); International fleets added 3200 to 11 800 birds per year; Bounded totals were 5200, 10 000 and 13 800 birds per year, or 1.9, 3.7 and 5 percent of a population of 300 000; Declines were likely over 20 years at the best case and over 60 years at the best bycatch estimate},
  software = {not_applicable},
  species = {Black-footed albatross},
  time_period = {1994-2000},
  variables = {Bycatch per unit effort; Observer coverage; Fishing effort; Bycatch estimates; Population size; Adult survival; Fecundity; Population growth rate},
}

@article{lewison2004understanding,
  author = {Lewison, Rebecca L and Crowder, Larry B and Read, Andrew J and Freeman, Sloan A},
  journal = {Trends in ecology \& evolution},
  number = {11},
  pages = {598--604},
  publisher = {Elsevier},
  title = {Understanding impacts of fisheries bycatch on marine megafauna},
  volume = {19},
  year = {2004},
  abstract = {Hunting by humans played a major role in extirpating terrestrial megafauna on several continents and megafaunal loss continues today in both terrestrial and marine ecosystems. Recent declines of large marine vertebrates that are of little or no commercial value, such as sea turtles, seabirds and marine mammals, have focused attention on the ecological impacts of incidental take, or bycatch, in global fisheries. In spite of the recognition of the problem of bycatch, few comprehensive assessments of its effects have been conducted.},
  analytical_methods = {Literature review; Comparison of logbook and observer data; Demographic profiles of at-risk species; Discussion of assessment approaches under uncertainty},
  category = {Justification},
  equations = {not_applicable},
  island = {Global},
  keywords = {not_applicable},
  limitations = {Bycatch data are sparse and demographic knowledge is often rudimentary; Observer effort is low and logbooks underreport bycatch; Substantial fishing effort is unreported; Wide distributions and multinational fleets require a large-scale perspective},
  objectives = {Review current research on the effects of fisheries bycatch on marine megafauna; Address the data limitations and spatial scale that make assessments difficult; Identify future research directions},
  research_question = {In spite of the recognition of the problem of bycatch, few comprehensive assessments of its effects have been conducted.},
  results = {Six of the seven sea turtle populations are listed as threatened; Sea turtle egg survival can be as low as 20 percent; About one million pounds of corals and sponges were destroyed in Alaskan waters between 1997 and 1999; Finning increased during the 1980s and 1990s; Understanding of population-level and ecosystem effects of bycatch remains nascent},
  software = {not_applicable},
  species = {Sea turtles; Seabirds; Sharks; Marine mammals},
  time_period = {not_applicable},
  variables = {Bycatch rate; Fishing effort; Observer coverage; Population size; Demographic rates; Age structure; Spatial scale; Uncertainty},
}

@article{lewison2005thinking,
  author = {Lewison, Rebecca L and Nel, Deon C and Taylor, Frances and Croxall, John P and Rivera, Kim S},
  journal = {Marine Ornithology},
  number = {5},
  publisher = {Pacific Seabird Group},
  title = {Thinking big--taking a large-scale approach to seabird bycatch},
  volume = {33},
  year = {2005},
  abstract = {Understanding the impact of fisheries bycatch on seabird species involves both quantifying the number of individuals affected (including lethal and sub-lethal effects) and determining the effect, if any, that bycatch could have at the population or community level. Fisheries bycatch is only one of several human-mediated disturbances that may threaten seabird populations. Introduced predators, toxin contamination, disease and other disturbances are also likely to impact negatively upon populations (Arcos et al. 2002, Finkelstein et al. 2003, Weimerskirch 2004).},
  analytical_methods = {Review of published and released bycatch data through 2005; Compilation of data sources in a global map; Comparison of national and fleet-specific assessments with ocean-wide perspectives; Discussion of the role of regional fisheries management organizations},
  category = {Justification},
  equations = {not_applicable},
  island = {Global},
  keywords = {not_applicable},
  limitations = {Data limitations in quantity and quality; Uncertainty in analytical methods and assumptions; Dynamic natural systems are difficult to understand; International coordination and data sharing are required},
  objectives = {Show that seabird distributions and fishing fleets span many nations, so national assessments capture only a fraction of bycatch; Argue that a large-scale perspective is required to characterize bycatch effects and track mitigation; Highlight the role of regional fisheries management organizations; Call for international coordination, data sharing and regional analyses},
  research_question = {Because seabirds encounter many fishing fleets, bycatch assessments at the national, or fleet-specific, level can represent only a small fraction of the bycatch from a much larger total.},
  results = {Published or released bycatch data for longline fisheries were compiled through 2005 from 36 sources; For some fisheries, data extend over more than a decade; Seabirds of conservation concern can encounter as many as 12 sovereign nations and economic zones; National assessments can capture only a small fraction of total bycatch},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {not_applicable},
  variables = {Bycatch coverage; Fishing effort; Bycatch rates; Species distribution; Number of nations and economic zones; Sex and age classes},
}

@article{mendez2022population,
  author = {M\'endez S\'anchez, Federico and Bedolla Guzm\'an, Yuliana and Rojas Mayoral, Evaristo and Aguirre-Mu\~noz, Alfonso and Koleff, Patricia and Aguilar Vargas, Alejandro and \'Alvarez Santana, Fernando and Arnaud, Gustavo and Aztorga Ornelas, Alicia and Beltr\'an Morales, Luis Felipe and others},
  journal = {PLOS ONE},
  number = {10},
  pages = {e0258632},
  publisher = {Public Library of Science San Francisco, CA USA},
  title = {Population trends of seabirds in Mexican Islands at the California Current System},
  volume = {17},
  year = {2022},
  abstract = {To assess population trends, we analyzed these data and show results for 19 seabird species on ten island groups. The maximum number of breeding pairs for each nesting season was used to estimate the population growth rate (λ) for each species at every island colony. We performed a moving block bootstrap analysis to assess whether seabird breeding populations are increasing or decreasing.},
  analytical_methods = {Annual counts of active nests from land and boat surveys every 15 days; Burrow searches with occupancy assessment; Density estimates from random plots at peak incubation; Nonparametric bootstrap resampling of density with 2000 repetitions and 95% percentile intervals; Kernel density estimate for nesting area; Maximum breeding pairs per season; Moving block bootstrap regression with blocks of 3 consecutive records and 2000 repetitions; Hypotheses on lambda at alpha 0.1; Regional sums across colonies},
  category = {Background},
  equations = {Exponential population growth model; Percent change in breeding pairs; Bootstrap nest and burrow density estimate; Moving block bootstrap interval for lambda},
  island = {Baja California Pacific Islands, Mexico},
  keywords = {not_applicable},
  limitations = {The Magdalena Bay islands were not sampled; The regional trend excludes the Royal Tern, which lacked three consecutive years of data},
  objectives = {Determine the current abundance of the seabird populations on the BCPI; Determine their population trends},
  research_question = {No attempt had been made to understand the dynamics of the BCPI seabird populations, and the last regional estimates dated from 1999 to 2003.},
  results = {The BCPI support 129 breeding populations of 23 species and over one million birds annually; Trends were assessed for 19 species on ten island groups; 31 populations of 14 species are significantly increasing and 11 populations of 7 species are decreasing; 19 populations showed no significance, and 15 of them had lambda above 1; 12 of the 18 species with a regional trend are increasing; The islands support 400,000 to 1.4 million breeding individuals},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {2003-2019},
  variables = {Breeding pairs per nesting season; Population growth rate; Percent change in population; Island or archipelago; Colony; Species; Nesting type; Nest and burrow density; Nesting surface area},
}

@book{ministry2013national,
  author = {Ministry for Primary Industries},
  publisher = {Ministry for Primary Industries Wellington, New Zealand},
  title = {National Plan of Action---2013: To reduce the incidental catch of seabirds in New Zealand Fisheries},
  year = {2013},
  abstract = {This New Zealand NPOA-Seabirds 2013, taking account of the BPTG, establishes New Zealand’s approach to reducing the incidental mortality of seabirds from fishing. It sets out a long term objective, some supporting high level subsidiary objectives and objectives to be met within the first five years. It outlines the management mechanisms for ensuring that the objectives are achieved including through the establishment of clear accountabilities for overall progress and a process of annual reporting and review of fisheries specific objectives contained in the national annual and five year fisheries planning documents.},
  analytical_methods = {Exposure-effects approach to risk assessment; Two stages: impact assessment of birds killed and population-level risk assessment; Hierarchical framework with level 1 qualitative, level 2 semi-quantitative and level 3 quantitative assessments; Risk ratio of aggregate fatalities to Potential Biological Removals; Development of long term, high level and five year objectives; Management measures and annual reporting; Review after four years},
  category = {Background},
  equations = {Risk ratio of aggregate potential fatalities to Potential Biological Removal},
  island = {New Zealand},
  keywords = {not_applicable},
  limitations = {Low observer coverage limits information on progress in inshore and domestic tuna and swordfish longline fisheries; Understanding of non-commercial captures is limited; Mortality from superstructure collision is unaccounted for in risk assessments},
  objectives = {New Zealand seabirds thrive without pressure from fishing related mortalities; All fishers implement current best practice mitigation measures and reduce incidental mortality; Incidental mortality stays at or below a level allowing favourable conservation status; Mitigation, observation and monitoring methods improve through research; Fleets beyond New Zealand waters use best practice mitigation},
  research_question = {Although progress had been made in some New Zealand fisheries, much remained to be done in others and beyond New Zealand jurisdiction.},
  results = {The level 1 assessment scored 101 seabird taxa and 26 fishing methods; Thalassarche albatrosses, Procellaria petrels and large shearwaters were at greatest national risk; Commercial set nets posed the greatest fishery risk, followed by inshore bottom longline; Deepwater longline and trawl risk had been reduced; Inshore trawl, bottom longline and small-vessel surface longline contributed most remaining risk},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {2013-2018},
  variables = {Capture rates; Incidental mortality levels; Biological risk categories; Potential Biological Removals; Observer coverage; Mitigation implementation; Conservation status; Fishing effort},
}

@techreport{morgan2016fourth,
  author = {Morgan, Sian and Alvarez Flores, Carlos},
  institution = {SCS Global Services},
  title = {Fourth Annual MSC Surveillance Audit Report. Gulf of California Mexican Sardine Fishery},
  year = {2016},
  abstract = {The Gulf of California Mexican Sardine fishery was certified on 21 July, 2011 by SCS Global Services, Inc. (SCS). This 2015 report represents the findings of the fourth annual surveillance since the fishery was certified. SCS finds that the Fishery is still in general compliance with the MSC standard. SCS recommends the continued use of the MSC certificate.},
  analytical_methods = {Surveillance audit under the MSC Certification Requirements version 1.3; Questions from the certification body; Review of evidence provided by the client; Meetings with the client fishery; Site visit; Preliminary findings; Scoring of performance indicators against the standard; Final report within 60 days; Stakeholder submissions and team response},
  category = {Background},
  equations = {not_applicable},
  island = {Gulf of California, Mexico},
  keywords = {not_applicable},
  limitations = {All facts were provided by the client; The onboard observer program did not operate in the 2014-2015 season; The virtual population analysis and statistical population model have limitations},
  objectives = {Determine whether the fishery has sufficiently acted on the required conditions; Determine whether it is moving at an appropriate pace toward pending or new conditions; Verify through a random check that the fishery remains in compliance with the MSC standard and existing scores},
  research_question = {not_applicable},
  results = {Six conditions were closed and three remain open, two of them behind target; No new conditions were opened; Principle scores after the audit were 82.5, 82.0 and 85.1; Seven scores were increased to reflect improved performance; The fishery remained in general compliance and SCS recommended continued certification},
  software = {not_applicable},
  species = {Sardine},
  time_period = {2014-2015},
  variables = {Performance indicator scores; Condition status; Catch and effort; Catch per unit effort; Stock biomass; Observer coverage; Bycatch rates; Management measures},
}

@report{naughton2007conservation,
  author = {Naughton, M. B and Romano, M. D. and Zimmerman, T. S.},
  title = {A Conservation Action Plan for Black-footed Albatross (Phoebastria nigripes) and Laysan Albatross (P. immutabilis)},
  year = {2007},
  abstract = {In recognition of their conservation status and the ongoing threats facing these two species, this Conservation Action Plan (hereinafter “Plan”) is intended to provide a framework for partnership-based conservation and management actions. The purpose of the Plan is to facilitate a collaborative, proactive approach to albatross conservation. Implementing actions identified in this plan, to reduce threats and prevent or stem population declines in the present, will aid in preserving future management options and minimizing the cost of management and recovery.},
  analytical_methods = {Two workshops with agencies and experts; Synthesis of colony counts and bycatch estimates; Linear regression of log-transformed nest counts over 1922 to 2005, 1957 to 2005 and 1992 to 2005; Capture-recapture survival analysis; Threat assessment; Prioritisation of conservation actions},
  category = {Background},
  equations = {Log-linear regression of nest counts; Population growth rate above one; Adult survival rate},
  island = {North Pacific},
  keywords = {not_applicable},
  limitations = {Long-term data for colony counts, adult survival and bycatch are inadequate; Models relied on limited data and their conclusions did not always agree; Bycatch had to be estimated for unmonitored fleets},
  objectives = {Increase the worldwide black-footed albatross population above 60,000 pairs in Hawaii and 2,600 in Japan; Maintain adult survival adequate for a stable or increasing population; Reestablish black-footed colonies throughout the historical range; Maintain the Laysan albatross population at or above 600,000 pairs; Reestablish Laysan colonies throughout the historical range},
  research_question = {not_applicable},
  results = {Twenty-one islands supported colonies as of 2005; The Laysan albatross population was estimated at 590,000 pairs in 2005, with more than 99% in Hawaii; Black-footed counts increased over 1922 to 2005, were stable over 1957 to 2005 and declined over 1992 to 2005; Midway black-footed pairs rose from 8,700 in 1956 to 21,800 in 2005, while Laysan Island fell by 38%; Adult survival at Tern Island was 92% from 1997 to 2002},
  software = {not_applicable},
  species = {Black-footed albatross; Laysan albatross},
  time_period = {1922-2005},
  variables = {Nesting pairs; Adult survival; Population growth rate; Colony counts; Bycatch mortality; Threats to colonies},
}

@inproceedings{nikitopoulos2018hot,
  author = {Nikitopoulos, Panagiotis and Paraskevopoulos, Aris-Iakovos and Doulkeridis, Christos and Pelekis, Nikos and Theodoridis, Yannis},
  booktitle = {2018 IEEE International Conference on Big Data (Big Data)},
  organization = {IEEE},
  pages = {761--770},
  title = {Hot spot analysis over big trajectory data},
  year = {2018},
  abstract = {Hot spot analysis is the problem of identifying statistically significant spatial clusters from an underlying data set. In this paper, we study the problem of hot spot analysis for massive trajectory data of moving objects, which has many real-life applications in different domains, especially in the analysis of vast repositories of historical traces of spatio-temporal data (cars, vessels, aircrafts).},
  analytical_methods = {Spatio-temporal partitioning of the 3D space into cells; Getis-Ord statistic adapted with time spent per cell as density; Parallel exact algorithm THS; Approximate algorithm aTHS with an error bound; Implementation in Java on Apache Spark 2.2.0; Experiments varying cell size, neighbourhood distance and k},
  category = {Methods},
  equations = {Getis-Ord statistic; Cell mean; Cell standard deviation; Spatial weight with exponential decay; Error bound of the approximation},
  island = {Eastern Mediterranean Sea},
  keywords = {Hot spot analysis; trajectory data; parallel processing; MapReduce; Apache Spark},
  limitations = {The exact algorithm may be computationally expensive depending on the grid partitioning and the number of cells; The approximate algorithm ignores distant cells and trades accuracy for speed},
  objectives = {Formulate the problem of trajectory hot spot analysis with the Getis-Ord statistic; Present a parallel exact algorithm; Propose an approximate algorithm with a bounded error; Implement the algorithms in Apache Spark and evaluate them on vessel trajectories},
  research_question = {The Getis-Ord statistic was designed for point data, so applying it to trajectories of moving objects is not straightforward.},
  results = {The vessel data set held 83,735,633 trajectories, about 1.9 billion records in 89.4 GB; A tenfold increase in cell size reduced execution time tenfold; Setting the neighbourhood distance to 3 tripled execution time compared with 1},
  software = {Apache Spark 2.2.0; Hadoop YARN 2.7},
  species = {not_applicable},
  time_period = {not_applicable},
  variables = {Density per cell; Getis-Ord z-score; p-value; Spatial weight; Cell size in space and time; Neighbourhood distance; Top-k cells; Approximation error},
}

@article{phillips2003effects,
  author = {Phillips, Richard A and Xavier, Jose C and Croxall, John P},
  journal = {The Auk},
  number = {4},
  pages = {1082--1090},
  publisher = {Oxford University Press},
  title = {Effects of satellite transmitters on albatrosses and petrels},
  volume = {120},
  year = {2003},
  abstract = {Effects of deployment of miniaturized transmitters and loggers have been well studied in penguins, but much less so in flying seabirds. We examined the effects of satellite tag (platform terminal transmitter, PTT) deployment in Black-browed (Thalassarche melanophris) and Gray-headed (T. chrysostoma) albatrosses at South Georgia and reviewed the recent literature for other albatrosses and petrels. In our study, although a few individuals may have slightly extended their foraging trips, overall there was no significant difference in trip duration, meal mass, breeding success, or rate of return in the next season between birds with PTTs and controls.},
  analytical_methods = {PTT deployment on 19, 22 and 12 Black-browed albatrosses and dummy PTTs on six Gray-headed albatrosses; Daily nest checks for control pairs; ANCOVA with days since laying covariates; Repeated measures ANOVA; t-test and Levene test; Literature review},
  category = {Methods},
  equations = {Cubic function of days since laying},
  island = {Bird Island, South Georgia},
  keywords = {not_applicable},
  limitations = {Different studies are rarely directly comparable; Even small, light transmitters will probably affect small petrels and shearwaters},
  objectives = {Examine the effects of PTT deployment on Black-browed and Gray-headed albatrosses at South Georgia; Review recent literature for other albatrosses and petrels; Recommend ways to minimize device effects},
  research_question = {Effects of deployment of miniaturized transmitters and loggers have been well studied in penguins, but much less so in flying seabirds.},
  results = {No significant difference in trip duration (6.5 vs 7.1 days; GLM F = 0.70, P = 0.40), meal mass, breeding success or return rate; Gray-headed trips lasted 10.3 vs 9.0 days (P = 0.69); Chick survival was 67 vs 50 percent; Most other studies recorded extended trips and desertion where loads exceeded 3 percent of adult mass},
  software = {not_applicable},
  species = {Albatrosses; Petrels},
  time_period = {1999-2002},
  variables = {Trip duration; Meal mass; Breeding success; Rate of return; Instrument mass as a proportion of body mass; Attachment method; Handling time; Nest desertion},
}

@article{phillips2006year,
  author = {Phillips, Richard A and Silk, Janet RD and Croxall, John P and Afanasyev, Vsevolod},
  journal = {Biological conservation},
  number = {3},
  pages = {336--347},
  publisher = {Elsevier},
  title = {Year-round distribution of white-chinned petrels from South Georgia: relationships with oceanography and fisheries},
  volume = {129},
  year = {2006},
  abstract = {The white-chinned petrel Procellaria aequinoctialis is a medium-sized procellariiform with a circumpolar subAntarctic breeding distribution. Feeding during both day and night, and often competing aggressively for bait, offal and discards, it has the highest incidental mortality rate of any seabird in Southern Ocean longline fisheries. Although still abundant, the limited census data suggest rapid population declines. Using geolocators, the movements of 10 white-chinned petrels from South Georgia were tracked for 226–664 days, which in combination with previous satellite-tracking provided the first comprehensive description of migration routes and year-round distribution of this species from any site.},
  analytical_methods = {Geolocators on 35 adults in February 2003; Light-based locations twice per day; Speed filter and smoothing; Kernel density maps in ArcGIS with 50 km cells and 200 km search radius; Satellite tracks from 1996 to 1998; Oceanographic data; Overlap with longline effort},
  category = {Similar work},
  equations = {Kernel density estimate},
  island = {Bird Island, South Georgia},
  keywords = {Bycatch; Conservation; Incidental mortality; Migration; Winter philopatry},
  limitations = {Geolocator accuracy is poorer than satellite telemetry; Sample sizes were limited to 8 to 10 birds at each stage; Locations are unavailable around the equinoxes; Distances and speeds are only approximate},
  objectives = {Identify the key wintering areas used by white-chinned petrels from South Georgia; Extend the sample of tracks obtained during the early breeding season; Examine individual variability in site preference; Determine the oceanographic factors underlying site selection and their temporal variation; Quantify spatio-temporal overlap with fisheries},
  research_question = {In contrast, there is little information on winter distribution beyond observations that densities increase in northern subAntarctic and subtropical regions; furthermore, the age and provenance of the many birds caught in fisheries is largely unknown.},
  results = {Eleven of 35 loggers were retrieved, and 10 birds were tracked for a mean of 366 days (226 to 664); 3251 locations were validated; Failed breeders left South Georgia between 5 and 18 February; Core winter areas lay east of the River Plate, off Bahía Blanco and west of Chiloé; Two birds moved to the Humboldt Current; Pre-laying and incubation trips exceeded 2000 km while chick-rearing trips averaged 610 km; The distribution overlapped major longline and trawl fisheries},
  software = {ArcGIS Spatial Analyst},
  species = {White-chinned petrel},
  time_period = {1996-2005},
  variables = {Location; Trip duration; Maximum range; Cumulative distance; Migration timing; Oceanographic factors; Fishing effort; Spatial overlap},
}

@article{phillips2024incidental,
  author = {Phillips, Richard A and Fox, Emma and Crawford, Rory and Prince, Stephanie and Yates, Oliver},
  doi = {10.1016/j.biocon.2024.110720},
  journal = {Biological Conservation},
  month = {jul},
  pages = {110720},
  publisher = {Elsevier},
  title = {Incidental mortality of seabirds in trawl fisheries: A global review},
  url = {https://doi.org/10.1016/j.biocon.2024.110720},
  volume = {296},
  year = {2024},
  abstract = {However, given the scale of cryptic mortality and the many unmonitored or poorly monitored fisheries, the actual global mortality in trawl fisheries will be much higher. The most bycaught species were albatrosses and large petrels (many of which are threatened) in the Southern Hemisphere, and gannets in the Northern Hemisphere. The few long-term studies indicated that mitigation measures (particularly strategic offal management and bird-scaring lines) were effective at reducing bycatch rates. Much improved regulations, and close monitoring of compliance and bycatch rates are essential for ensuring trawl fisheries do not continue to have major impacts on vulnerable seabird populations.},
  analytical_methods = {Literature review of peer-reviewed and unpublished reports; Searches in Web of Science and Google Scholar; Contact with 23 regional experts; Extraction of fishery, effort, observer coverage and bycatch data; Calculation of birds per unit effort; Gap analysis of fisheries without adequate monitoring; Comparison of bycatch before and after mitigation},
  category = {State of the art},
  equations = {not_applicable},
  island = {Global},
  keywords = {Bycatch mitigation; Global bycatch; Seabirds; Threatened species; Trawl fisheries},
  limitations = {Data gaps and incomplete coverage; Variability in bycatch rates; Low observer coverage; Cryptic mortality; Inconsistent reporting and monitoring protocols; Limited regional focus; Dependence on existing literature},
  objectives = {Estimate a global total of seabird bycatch in trawl fisheries; Conduct a gap analysis for fisheries without adequate monitoring; Identify the seabird families and species most susceptible to bycatch in different regions; Compare bycatch totals or rates before and after mitigation},
  research_question = {There is still no global estimate of seabird bycatch in trawl fisheries.},
  results = {44,000 birds per year from monitored trawl fisheries; Bycatch rates were highly variable across fisheries; Bycatch was concentrated in Australia, New Zealand, South America and southern Africa; Albatrosses, large petrels and gannets were the species most affected; Offal management and bird-scaring lines were effective; Data gaps remain in European and Asian waters; Observer coverage rarely exceeded 10% of fishing effort; Bycatch in trawl fisheries is one of the highest threats to seabird populations globally},
  software = {not_applicable},
  species = {Albatrosses; Petrels; Gannets},
  time_period = {1996-2022},
  variables = {Seabird bycatch rates; Bycatch totals; Fishing effort; Species affected; Geographical regions; Mitigation measures; Observer coverage; Data gaps and uncertainties; Cryptic mortality; Life-history characteristics of seabirds},
}


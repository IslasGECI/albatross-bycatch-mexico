@article{pitman2004population,
  author = {Pitman, Robert L and Walker, William A and Everett, William T and Gallo-Reynoso, Juan Pablo},
  journal = {Marine Ornithology},
  pages = {159--165},
  title = {Population status, foods and foraging of Laysan Albatross Phoebastria immutabilis nesting on Guadalupe Island, Mexico},
  volume = {32},
  year = {2004},
  abstract = {During the 1983/84 winter breeding season, Laysan Albatrosses Phoebastria immutabilis bred in the eastern Pacific for the first time in recorded history, on Guadalupe Island, Mexico. By 1991/92, the last reported census, the population had grown to 45 pairs. We conducted censuses during 1999/2000 and 2000/01 and found that, in addition to nesting at the only previously known colony (on the main island), albatrosses were breeding at another site on the main island and on two offshore islets.},
  analytical_methods = {Censuses in January and June 2000 and December 2000; Counts of nests, adults and chicks at each colony; Collection of chick regurgitation pellets in June 2000; Identification of lower beaks against reference specimens; Frequency of occurrence of prey taxa; Measurement of lower rostral length},
  category = {Background},
  equations = {not_applicable},
  island = {Guadalupe Island, Mexico},
  keywords = {Laysan Albatross; Phoebastria immutabilis; Guadalupe Island; population status; foods; foraging; scavenging; squid},
  limitations = {Counts are minimum estimates; The main island could not be checked in June 2000; Direct comparisons with earlier censuses are not possible because they omitted the newer sites; Pellets contain only indigestible hard parts},
  objectives = {Update information on the number of Laysan albatrosses breeding at Guadalupe Island; Provide data on their food habits from squid beaks in chick regurgitation pellets; Comment on their foraging habits relative to how and when they feed},
  research_question = {No data on Laysan albatross food habits were available from eastern Pacific populations.},
  results = {119 and 193 pairs nested in the two seasons; Four breeding sites were found, three of them new; 27 pellets held 967 prey items, including 964 cephalopods; The prey represented at least 12 families and 22 species; Histioteuthis hoylei made up 20.4 percent of identified beaks, Taonius borealis 13.8 percent, Gonatus pyros 11.2 percent and Galiteuthis sp. 11.0 percent; No ommastrephid squids were found},
  software = {not_applicable},
  species = {Laysan albatross},
  time_period = {1999-2001},
  variables = {Number of nesting pairs; Breeding sites; Prey items; Cephalopod families and species; Frequency of occurrence; Beak size},
}

@report{richard2020assessment,
  author = {Richard, Yvan and Abraham, Edward R and Berkenbusch, Katrin},
  institution = {Fisheries New Zealand, Tini a Tangaroa},
  title = {Assessment of the risk of commercial fisheries to New Zealand seabirds, 2006-07 to 2016-17},
  year = {2020},
  abstract = {Seabirds are incidentally caught in commercial fisheries in New Zealand waters, with a range of species featuring in bycatch records across different fisheries. The potential impact of these incidental captures on seabird populations breeding within New Zealand’s Exclusive Economic Zone has been regularly assessed through a systematic risk assessment framework, which allowed the identification of species and fisheries associated with the highest risk and the monitoring of changes in risk status over time.},
  analytical_methods = {Spatially explicit fisheries risk assessment framework; Encounter rate from spatial overlap between seabirds and fishing effort; Capture probability from observer records; Extrapolation to unobserved fishing effort; Cryptic multiplier applied to observed captures; Population sustainability threshold from demographic parameters; Risk ratio of deaths to the threshold; Annual average effort from 2014-15 to 2016-17; Risk categories from the median and upper 95 percent credible interval},
  category = {Justification},
  equations = {Risk ratio of fishery-related deaths to the population sustainability threshold; Population sustainability threshold adapted from potential biological removal; Cryptic multiplier as the inverse of the recording probability},
  island = {New Zealand},
  keywords = {not_applicable},
  limitations = {Cryptic mortality may be poorly estimated for some fisheries and species, so trawl estimates should be interpreted with caution; Bycatch and population data are incomplete or uncertain for some species},
  objectives = {Provide an updated assessment of the risk of commercial fisheries to 71 seabird taxa breeding in the New Zealand region; Include two additional years of data, 2015-16 and 2016-17; Incorporate data corrections identified during preparation of observer and capture data},
  research_question = {not_applicable},
  results = {71 seabird taxa were assessed; An estimated mean of 12,900 fishery-related deaths per year (95 percent c.i. 10,900 to 15,400); Trawl fisheries accounted for 8,840 deaths, bottom-longline 2,840, surface-longline 1,100 and set nets 128; Black petrel was the only species at very high risk; Five taxa were at high risk, including Salvin's albatross and Westland petrel; Four species changed risk category after the corrections},
  software = {PostgreSQL; R; JAGS; Python; LaTeX},
  species = {Seabirds},
  time_period = {2006-2017},
  variables = {Risk ratio; Total fishery-related deaths; Population sustainability threshold; Encounter rate; Capture probability; Cryptic multiplier; Vulnerability; Population size and productivity; Population outcome},
}


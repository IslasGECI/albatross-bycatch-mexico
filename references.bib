@article{rouyer2026highly,
  author = {Rouyer, Marie-Morgane and Rodrigues, Ana SL and Davies, Tammy E and Clark, Bethany L and Pearmain, Elizabeth J and Bhola, Nina and Carneiro, Ana PB and Gonz{\'a}lez-Sol{\'\i}s, Jacob and Guilherme, Jo{\~a}o L and Abdennadher, Aida and others},
  journal = {Conservation Letters},
  number = {5},
  pages = {e70075},
  publisher = {Wiley Online Library},
  title = {Highly Mobile Seabirds Reveal Areas of Conservation Importance Across the Atlantic Ocean},
  volume = {19},
  year = {2026},
  abstract = {Here, we analyze tracking data on > 13,000 individuals (44 species, eight families) to map the distribution of highly mobile seabirds in the Atlantic Ocean and adjacent seas throughout the year. We identify regions important year-round or seasonally. The High Seas are as important as national waters for highly mobile seabirds but are even less protected. Current Atlantic MPAs hold < 14% of tracked species density, but their expansion to 30% of the ocean could protect up to two thirds.},
  analytical_methods = {Definition of Atlantic highly mobile seabirds, 82 candidates and 44 with tracking data; Compilation from the Seabird Tracking Database, Movebank, SEATRACK and published datasets; Assignment of colonies to large marine ecosystems; Assessment of tracking coverage of each Atlantic population; Weighted kernel density estimation per population and month; Species density rasters summed into quarterly multi-species density; Overlay with the MPA network; Static and dynamic 30 percent expansion scenarios},
  category = {Similar work},
  equations = {not_applicable},
  island = {Atlantic Ocean},
  keywords = {30 by 30; Atlantic; area-based management; biologging; conservation; high seas; marine protected areas; marine spatial planning; migratory species; seabirds},
  limitations = {The maps are too coarse for fine-scale space use; Only adults are included; Species are unevenly represented, with some absent and others poorly tracked; Geolocator accuracy is lower at equinoxes and high latitudes},
  objectives = {Compile and synthesize a tracking dataset to reveal the spatio-temporal distribution of highly mobile seabirds across the Atlantic; Quantify the relative importance of national and international waters; Evaluate current MPA coverage and compare it with maximum coverage at the same area and under a 30 percent expansion},
  research_question = {Tracking data are usually collected for a single species or region, which precludes identifying important areas for multiple species at ocean-basin scale.},
  results = {13,060 individuals of 44 species and eight families supplied 3,560,488 locations from 1990 to 2021; 206 colonies in more than 20 countries were represented; The Atlantic MPA network covers 6.9 percent of the area and holds 11.1 to 13.3 percent of tracked species density; National waters hold 47 to 53 percent of density and the High Seas 46 to 52 percent; Expansion to 30 percent could protect 65.6 to 69.5 percent statically and 69.3 to 71.5 percent dynamically},
  software = {not_applicable},
  species = {Seabirds},
  time_period = {1990-2021},
  variables = {Tracked species density; Seasonal distribution; Extent of national and international waters; MPA coverage; Population coverage by tracking; Core areas of each species},
}

@article{safina1995world,
  author = {Safina, Carl},
  journal = {Scientific American},
  number = {5},
  pages = {46--53},
  publisher = {Scientific American},
  title = {The world's imperiled fish},
  volume = {273},
  year = {1995},
  abstract = {Because wild fish regenerate at rates determined by nature, attempts to increase their supply to the marketplace must eventually run into limits. That threshold seems to have been passed in all parts of the Atlantic, Mediterranean and Pacific: these regions each show dwindling catches. Worldwide, the extraction of wild fish peaked at 82 million metric tons in 1989. Since then, the long-term growth trend has been replaced by stagnation or decline.},
  analytical_methods = {Review of FAO catch statistics; Regional comparison of peak years and changes to 1992; Case studies of collapsed fisheries; Synthesis of fishing technology and bycatch evidence},
  category = {Justification},
  equations = {not_applicable},
  island = {Global},
  keywords = {not_applicable},
  limitations = {Bycatch statistics probably underestimate the waste because much bycatch goes unreported},
  objectives = {Show that industrial fishing has reduced fish populations and destabilized marine ecosystems; Explain the failure to recognize fish as wildlife; Argue that catches must run into natural limits},
  research_question = {Fisheries management had failed to recognize that fish are wildlife and that catches must have limits.},
  results = {World extraction peaked at 82 million metric tons in 1989; Some landings fell by more than 50 percent from peaks in the early 1970s; Regional catches peaked between 1973 and 1991; Grand Banks and Georges Bank are essentially closed; 80 to 90 percent of fish in some populations are removed each year; Five low-value species made up nearly 30 percent of the world catch in the 1980s but 6 percent of its value},
  software = {not_applicable},
  species = {Fish},
  time_period = {1973-1992},
  variables = {Catch landings; Peak catch year; Change in catch; Monetary value of catch; Aquaculture output; Share of species in the catch},
}

@article{soanes2013many,
  author = {Soanes, Louise M and Arnould, John PY and Dodd, Stephen G and Sumner, Michael D and Green, Jonathan A},
  journal = {Journal of Applied Ecology},
  number = {3},
  pages = {671--679},
  publisher = {Wiley Online Library},
  title = {How many seabirds do we need to track to define home-range area?},
  volume = {50},
  year = {2013},
  abstract = {Seabird and marine mammal tracking studies are increasingly being used to aid the designation of marine conservation zones and to predict important foraging areas. We suggest that many studies may be underestimating the size of these foraging areas and that better estimates could be made by considering both the duration and number of data logger deployments. Researchers intending to draw conclusions from tracking data should conduct a similar analysis of their data as used in this study to determine the reliability of their home-range area predictions.},
  analytical_methods = {GPS tracking of two species at one colony; Interpolation of fixes to 10 seconds with the R package trip; Exclusion of fixes at or within 300 metres of the colony; Grid of 1 by 1 kilometre cells ranked by time spent; Bootstrap with 10000 iterations for confidence intervals; Fitting of Michaelis-Menten and three-parameter asymptotic exponential models; Model selection by AIC; Sensitivity analysis of model predictions},
  category = {Methods},
  equations = {Michaelis-Menten asymptotic model; Three-parameter asymptotic exponential model},
  island = {Puffin Island, Wales},
  keywords = {central-place foragers; global positioning system; home-range area; marine protected area},
  limitations = {GPS fixes were biased because devices did not always record positions, partly due to diving; Kernel density methods were unsuitable for the data; The study covered the chick-rearing period only},
  objectives = {Determine how many individuals should be used to predict the home-range area of a colony; Determine how many trips should be used; Determine the optimum combination of individuals and trips for a sampling protocol},
  research_question = {Tracking studies were often conducted without considering how many individuals to track and for how long.},
  results = {The first trip predicted a 56 percent smaller area of active use for shags and a 43 percent smaller area for kittiwakes; With four trips, 39 shags and 83 kittiwakes were needed to predict 95 percent of the area of active use; With one trip, 135 shags and 248 kittiwakes were needed; 19 shags and 21 kittiwakes were tracked, with 18 and 14 contributing at least four trips},
  software = {R; trip; boot; ArcGIS Desktop 10},
  species = {European shag; Black-legged kittiwake},
  time_period = {2010-2011},
  variables = {Area of active use; Core foraging area; Number of individuals; Number of foraging trips; Time spent per grid cell},
}

@article{soanes2016defining,
  author = {Soanes, Louise M and Bright, JA and Angel, LP and Arnould, JPY and Bolton, M and Berlincourt, Maude and Lascelles, B and Owen, E and Simon-Bouhet, Benoit and Green, JA},
  journal = {Biological Conservation},
  pages = {69--79},
  publisher = {Elsevier},
  title = {Defining marine important bird areas: Testing the foraging radius approach},
  volume = {196},
  year = {2016},
  abstract = {Recent international initiatives have promoted a number of different approaches to identify marine Important Bird and biodiversity Areas (IBAs), which are important areas for foraging, migrating or over-wintering seabirds. The ‘Foraging Radius Approach’ is one of these and uses known foraging range and habitat preferences to predict the size and location of foraging areas around breeding colonies. Here we assess the performance of the Foraging Radius Approach using GPS tracking data from six seabird species with a variety of foraging modes.},
  analytical_methods = {GPS tracking of six species at three colonies; Interpolation of fixes to 10 seconds with adehabitatLT; Bootstrap resampling and a Michaelis-Menten asymptotic model to predict population home-range areas; Kernel density polygons for core foraging areas; Extraction of depths with marmap and ArcMap; Kolmogorov-Smirnov tests of depth distributions; Foraging Radius Approach areas built from published radii and refined by depth preferences; Ratio of approach area to population home-range area},
  category = {Methods},
  equations = {Michaelis-Menten asymptotic model; Ratio of approach area to population home-range area},
  island = {Global},
  keywords = {GPS tracking; seabirds; home-range area; Marine Protected Area; conservation},
  limitations = {GPS devices did not always record positions, which may bias the sample; Only chick-rearing birds were tracked; Long trips of short-tailed shearwaters were excluded; Samples of 8 to 30 individuals likely underestimate population home ranges},
  objectives = {Assess the performance of the Foraging Radius Approach using GPS tracking data from six seabird species; Compare population home-range areas with the areas defined by the approach; Assess whether basic depth preferences from tracking data improve the estimates},
  research_question = {The performance of the Foraging Radius Approach had not been assessed across species with different foraging modes.},
  results = {Maximum-radius areas encompassed the entire population home range for five of six species but overestimated its size by a factor of 4 to 14 for five species; Mean-radius areas overestimated for half the species and underestimated for the rest; Depth distributions in core areas differed from those available within the maximum radius for five species (D = 0.12 to 0.77, p < 0.01); Mean foraging radii in this study were 61 percent greater to 45 percent lower than previously reported},
  software = {R; adehabitatLT; marmap; ArcMap},
  species = {European shag; Black-legged kittiwake; Razorbill; Masked booby; Little penguin; Short-tailed shearwater},
  time_period = {2010-2014},
  variables = {Population home-range area; Foraging Radius Approach area; Maximum foraging radius; Mean maximum foraging radius; Mean foraging radius; Sea depth; Colony size},
}


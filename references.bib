@article{weimerskirch2020ocean,
  author = {Weimerskirch, Henri and Collet, Julien and Corbeau, Alexandre and Pajot, Adrien and Hoarau, Floran and Marteau, C{\'e}dric and Filippi, Dominique and Patrick, Samantha C},
  journal = {Proceedings of the National Academy of Sciences},
  number = {6},
  pages = {3006--3014},
  publisher = {National Acad Sciences},
  title = {Ocean sentinel albatrosses locate illegal vessels and provide the first estimate of the extent of nondeclared fishing},
  volume = {117},
  year = {2020},
  abstract = {With threats to nature becoming increasingly prominent, in order for biodiversity levels to persist, there is a critical need to improve implementation of conservation measures. In the oceans, the surveillance of fisheries is complex and inadequate, such that quantifying and locating nondeclared and illegal fisheries is persistently problematic. Given that these activities dramatically impact oceanic ecosystems, through overexploitation of fish stocks and bycatch of threatened species, innovative ways to monitor the oceans are urgently required.},
  analytical_methods = {Deployment of radar-detecting and GPS loggers on 169 albatrosses; Transmission of detections through the Argos system; Tracking from Crozet, Kerguelen and Amsterdam between November 2018 and March 2019; Matching of radar detections to AIS signals within 30 kilometres; Fisher exact test and chi-square tests; Analyses in Statistica},
  category = {Methods},
  equations = {not_applicable},
  island = {Southern Indian Ocean},
  keywords = {bio-logging; illegal fisheries; conservation; vessel attraction; seabird},
  limitations = {The test covered six months and 169 individuals of two species in the southern Indian Ocean; The authors present Ocean Sentinel as a complementary tool rather than a replacement for patrols; Absence of AIS was assessed within a 30 kilometre threshold},
  objectives = {Test the feasibility of the Ocean Sentinel concept for large-scale surveillance; Compare its efficiency with VMS, AIS satellite and naval surveillance; Estimate the proportion of vessels illegally deactivating their AIS; Obtain accurate information on interactions between fisheries and two threatened albatross species},
  research_question = {Surveillance of fisheries is complex and inadequate, so quantifying and locating nondeclared and illegal fisheries is persistently problematic.},
  results = {632,333 GPS locations and 5,108 radar detections were received, representing 353 boats over more than 47 million square kilometres; 28.2 percent of detections had no AIS signal within 30 kilometres; The share without AIS was 25.8 percent in EEZs and 36.9 percent in international waters; 77.4 percent of detections occurred over shelves and shelf edges},
  software = {Statistica 12},
  species = {Wandering albatross; Amsterdam albatross},
  time_period = {2018-2019},
  variables = {Radar detections; AIS presence; Vessel activity; Encounter duration; Species; Age; Breeding status},
}

@article{worton1989kernel,
  author = {Worton, Brian J},
  journal = {Ecology},
  number = {1},
  pages = {164--168},
  publisher = {Wiley Online Library},
  title = {Kernel methods for estimating the utilization distribution in home-range studies},
  volume = {70},
  year = {1989},
  abstract = {In this paper kernel methods for the nonparametric estimation of the utilization distribution from a random sample of locational observations made on an animal in its home range are described. They are of flexible form, thus can be used where simple parametric models are found to be inappropriate or difficult to specify. Two examples are given to illustrate the fixed and adaptive kernel approaches in data analysis and to compare the methods.},
  analytical_methods = {Fixed kernel density estimation; Adaptive kernel density estimation with a pilot estimate; Choices of smoothing parameter including least-squares cross-validation; Analysis of a published data set of 41 locations and a simulated set of 100; Comparison with the Fourier transform and harmonic mean methods},
  category = {Methods},
  equations = {Kernel density estimator; Adaptive kernel estimator; Least-squares cross-validation criterion; Confidence region; Harmonic mean},
  island = {not_applicable},
  keywords = {bivariate density estimation; data analysis; home range; kernel estimate; nonparametric estimation; probabilistic model; utilization distribution},
  limitations = {Independence of locations is assumed throughout; The smoothing parameter choice can be subjective with the ad hoc method; Kernel and parametric approaches should be used together, not in isolation},
  objectives = {Describe kernel methods for nonparametric estimation of the utilization distribution; Illustrate the fixed and adaptive kernel approaches with two data sets; Discuss choices of the smoothing parameter; Compare kernel methods with the Fourier transform method},
  research_question = {Simple parametric models may be inappropriate for utilization distributions, so nonparametric estimation is needed.},
  results = {The adaptive kernel with least-squares cross-validation gave the best results for both data sets; A fixed kernel with an ad hoc smoothing parameter also gave estimates of practical value; Smoothing parameters in the examples ranged from 0.77 to 10},
  software = {not_applicable},
  species = {not_applicable},
  time_period = {not_applicable},
  variables = {Utilization distribution; Smoothing parameter; Kernel estimate; Confidence region area},
}

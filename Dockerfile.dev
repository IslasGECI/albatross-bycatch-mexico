FROM islasgeci/albatross-bycatch-mexico:latest

# La imagen de producción lleva solo lo que necesita `make all`. El diccionario
# de español sirve a `make check` sobre el anteproyecto, así que vive aquí.
RUN apt update && apt install --yes \
        aspell-es && \
    apt clean && rm --force --recursive /var/lib/apt/lists/*
